diff --git a/dlls/win32u/ps5drv.c b/dlls/win32u/ps5drv.c
new file mode 100644
index 0000000000..9519b7fe4d
--- /dev/null
+++ b/dlls/win32u/ps5drv.c
@@ -0,0 +1,453 @@
+/*
+ * In-process user driver for the PS5
+ *
+ * A PS5 title runs Wine in its own process, with no explorer, no display
+ * server and no driver dll.  This driver reports one virtual monitor,
+ * gives each window a 32-bpp surface, composes the surfaces of visible
+ * top-level windows into one screen buffer and hands every flushed frame
+ * to pw_wine_present(), the title's single presentation sink.  Input the
+ * title derives from the DualSense arrives through pw_wine_next_input()
+ * and is injected as hardware input.  Both entry points are found with
+ * dlsym at load time: on the console they live in ntdll.prx, on a host
+ * build a test library provides them.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include <dlfcn.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "ntstatus.h"
+#include "ntgdi_private.h"
+#include "ntuser_private.h"
+#include "wine/server.h"
+#include "wine/debug.h"
+
+#ifdef WINE_PS5_USER_DRIVER
+
+WINE_DEFAULT_DEBUG_CHANNEL(ps5drv);
+
+/* the layout of PwWineInput in wine/ps5/pw_wine_sink.h */
+struct ps5_input
+{
+    UINT type;              /* 1 key, 2 mouse move, 3 mouse button */
+    UINT code;              /* virtual key, or button 0 left 1 right 2 middle */
+    INT  x, y;              /* mouse move: absolute desktop position */
+    UINT down;
+};
+
+enum { PS5_MAX_WINDOWS = 64, PS5_INPUT_BATCH = 64 };
+
+struct ps5_window
+{
+    HWND hwnd;
+    RECT visible;           /* screen coordinates */
+    BOOL shown;
+};
+
+static int (*present_frame)( const void *bgra, UINT width, UINT height, UINT stride );
+static int (*next_input)( struct ps5_input *input );
+static int (*input_fd)(void);
+
+static pthread_mutex_t screen_lock = PTHREAD_MUTEX_INITIALIZER;
+static UINT screen_width = 800, screen_height = 600;
+static UINT32 *screen;
+static struct ps5_window windows[PS5_MAX_WINDOWS];
+static UINT window_count;
+static POINT cursor;
+static BOOL display_published;
+static DWORD input_threads[PS5_MAX_WINDOWS];
+static UINT input_thread_count;
+
+static struct ps5_window *find_window( HWND hwnd )
+{
+    UINT i;
+    for (i = 0; i < window_count; i++) if (windows[i].hwnd == hwnd) return &windows[i];
+    return NULL;
+}
+
+/* screen_lock held */
+static void clear_screen_rect( const RECT *rect )
+{
+    RECT clip = {0, 0, screen_width, screen_height};
+    INT y;
+
+    if (!intersect_rect( &clip, &clip, rect )) return;
+    for (y = clip.top; y < clip.bottom; y++)
+        memset( screen + y * screen_width + clip.left, 0, (clip.right - clip.left) * 4 );
+}
+
+/* screen_lock held */
+static void present_screen(void)
+{
+    if (present_frame) present_frame( screen, screen_width, screen_height, screen_width * 4 );
+}
+
+/***********************************************************************
+ *           display
+ */
+static UINT ps5_UpdateDisplayDevices( const struct gdi_device_manager *manager, void *param )
+{
+    struct pci_id pci_id = {0};
+    struct gdi_monitor monitor = {0};
+    DEVMODEW mode = {.dmSize = sizeof(mode)};
+
+    mode.dmFields = DM_DISPLAYORIENTATION | DM_BITSPERPEL | DM_PELSWIDTH | DM_PELSHEIGHT |
+                    DM_DISPLAYFLAGS | DM_DISPLAYFREQUENCY | DM_POSITION;
+    mode.dmDisplayOrientation = DMDO_DEFAULT;
+    mode.dmBitsPerPel = 32;
+    mode.dmPelsWidth = screen_width;
+    mode.dmPelsHeight = screen_height;
+    mode.dmDisplayFrequency = 60;
+
+    SetRect( &monitor.rc_monitor, 0, 0, screen_width, screen_height );
+    monitor.rc_work = monitor.rc_monitor;
+
+    manager->add_gpu( "PS5", &pci_id, NULL, param );
+    manager->add_source( "PS5", DISPLAY_DEVICE_ATTACHED_TO_DESKTOP | DISPLAY_DEVICE_PRIMARY_DEVICE,
+                         NtUserGetSystemDpiForProcess( NULL ), param );
+    manager->add_monitor( &monitor, param );
+    manager->add_modes( &mode, 1, &mode, param );
+    return STATUS_SUCCESS;
+}
+
+/***********************************************************************
+ *           window surfaces
+ */
+static void ps5_surface_set_clip( struct window_surface *surface, const RECT *rects, UINT count )
+{
+}
+
+static BOOL ps5_surface_flush( struct window_surface *surface, const RECT *rect, const RECT *dirty,
+                               const BITMAPINFO *color_info, const void *color_bits, BOOL shape_changed,
+                               const BITMAPINFO *shape_info, const void *shape_bits )
+{
+    struct ps5_window *window;
+    UINT stride = color_info->bmiHeader.biWidth * 4;
+    RECT target, clip = {0, 0, screen_width, screen_height};
+    INT y;
+
+    pthread_mutex_lock( &screen_lock );
+    if ((window = find_window( surface->hwnd )) && window->shown)
+    {
+        /* dirty is relative to the surface, whose origin is the visible rect's */
+        target = *dirty;
+        OffsetRect( &target, window->visible.left, window->visible.top );
+        if (intersect_rect( &target, &target, &clip ) && intersect_rect( &target, &target, &window->visible ))
+        {
+            for (y = target.top; y < target.bottom; y++)
+            {
+                const BYTE *src = (const BYTE *)color_bits + (y - window->visible.top) * stride +
+                                  (target.left - window->visible.left) * 4;
+                memcpy( screen + y * screen_width + target.left, src, (target.right - target.left) * 4 );
+            }
+            present_screen();
+        }
+    }
+    pthread_mutex_unlock( &screen_lock );
+    return TRUE;
+}
+
+static void ps5_surface_destroy( struct window_surface *surface )
+{
+}
+
+static const struct window_surface_funcs ps5_surface_funcs =
+{
+    ps5_surface_set_clip,
+    ps5_surface_flush,
+    ps5_surface_destroy
+};
+
+static BOOL ps5_CreateWindowSurface( HWND hwnd, BOOL layered, const RECT *surface_rect,
+                                     struct window_surface **surface )
+{
+    char buffer[FIELD_OFFSET( BITMAPINFO, bmiColors[256] )];
+    BITMAPINFO *info = (BITMAPINFO *)buffer;
+    struct window_surface *previous = *surface;
+
+    if (previous && previous->funcs == &ps5_surface_funcs && EqualRect( &previous->rect, surface_rect ))
+        return TRUE;
+
+    memset( info, 0, sizeof(*info) );
+    info->bmiHeader.biSize        = sizeof(info->bmiHeader);
+    info->bmiHeader.biWidth       = surface_rect->right - surface_rect->left;
+    info->bmiHeader.biHeight      = -(surface_rect->bottom - surface_rect->top); /* top-down */
+    info->bmiHeader.biPlanes      = 1;
+    info->bmiHeader.biBitCount    = 32;
+    info->bmiHeader.biSizeImage   = get_dib_image_size( info );
+    info->bmiHeader.biCompression = BI_RGB;
+
+    *surface = window_surface_create( sizeof(**surface), &ps5_surface_funcs, hwnd, surface_rect, info, 0 );
+    if (previous) window_surface_release( previous );
+    return TRUE;
+}
+
+/***********************************************************************
+ *           windows
+ */
+/* Let the server wake this thread when the title posts input, as a
+ * display connection's fd does for the other drivers. Once per thread. */
+static void register_input_fd(void)
+{
+    DWORD tid = GetCurrentThreadId();
+    HANDLE handle;
+    UINT i;
+    int fd;
+
+    if (!input_fd || (fd = input_fd()) == -1) return;
+    pthread_mutex_lock( &screen_lock );
+    for (i = 0; i < input_thread_count; i++) if (input_threads[i] == tid) break;
+    if (i < input_thread_count || input_thread_count == PS5_MAX_WINDOWS)
+    {
+        pthread_mutex_unlock( &screen_lock );
+        return;
+    }
+    input_threads[input_thread_count++] = tid;
+    pthread_mutex_unlock( &screen_lock );
+
+    if (wine_server_fd_to_handle( fd, GENERIC_READ | SYNCHRONIZE, 0, &handle )) return;
+    SERVER_START_REQ( set_queue_fd )
+    {
+        req->handle = wine_server_obj_handle( handle );
+        wine_server_call( req );
+    }
+    SERVER_END_REQ;
+    NtClose( handle );
+}
+
+static BOOL ps5_CreateWindow( HWND hwnd )
+{
+    register_input_fd();
+    return TRUE;
+}
+
+static void ps5_WindowPosChanged( HWND hwnd, HWND insert_after, HWND owner_hint, UINT swp_flags,
+                                  const struct window_rects *new_rects, struct window_surface *surface )
+{
+    struct ps5_window *window;
+    BOOL shown = (NtUserGetWindowLongW( hwnd, GWL_STYLE ) & WS_VISIBLE) &&
+                 NtUserGetAncestor( hwnd, GA_PARENT ) == get_desktop_window();
+    BOOL repaint = FALSE;
+
+    pthread_mutex_lock( &screen_lock );
+    if (!(window = find_window( hwnd )) && shown && window_count < PS5_MAX_WINDOWS)
+    {
+        window = &windows[window_count++];
+        window->hwnd = hwnd;
+        window->shown = FALSE;
+    }
+    if (window)
+    {
+        if (window->shown && (!shown || !EqualRect( &window->visible, &new_rects->visible )))
+        {
+            clear_screen_rect( &window->visible );
+            present_screen();
+        }
+        /* a window just shown may have painted before it had this surface */
+        repaint = shown && !window->shown;
+        window->visible = new_rects->visible;
+        window->shown = shown;
+    }
+    pthread_mutex_unlock( &screen_lock );
+    if (repaint) NtUserRedrawWindow( hwnd, NULL, 0, RDW_INVALIDATE | RDW_ERASE | RDW_FRAME | RDW_ALLCHILDREN );
+}
+
+static void ps5_DestroyWindow( HWND hwnd )
+{
+    struct ps5_window *window;
+
+    pthread_mutex_lock( &screen_lock );
+    if ((window = find_window( hwnd )))
+    {
+        if (window->shown)
+        {
+            clear_screen_rect( &window->visible );
+            present_screen();
+        }
+        *window = windows[--window_count];
+    }
+    pthread_mutex_unlock( &screen_lock );
+}
+
+/* No explorer sizes the desktop the server created: make it the monitor. */
+static void ps5_SetDesktopWindow( HWND hwnd )
+{
+    RECT rect = {0, 0, screen_width, screen_height};
+
+    SERVER_START_REQ( set_window_pos )
+    {
+        req->handle    = wine_server_user_handle( hwnd );
+        req->previous  = 0;
+        req->swp_flags = SWP_NOZORDER;
+        req->window    = wine_server_rectangle( rect );
+        req->client    = req->window;
+        wine_server_call( req );
+    }
+    SERVER_END_REQ;
+
+    /* the prefix may hold another driver's display config: publish ours,
+     * which also gives the server the monitor that bounds the cursor */
+    if (!display_published)
+    {
+        display_published = TRUE;
+        update_display_cache( TRUE );
+    }
+}
+
+/***********************************************************************
+ *           input
+ */
+/* the most recently shown top-level window, or 0 */
+static HWND last_shown_window(void)
+{
+    HWND hwnd = 0;
+    UINT i;
+
+    pthread_mutex_lock( &screen_lock );
+    for (i = window_count; i > 0; i--)
+        if (windows[i - 1].shown) { hwnd = windows[i - 1].hwnd; break; }
+    pthread_mutex_unlock( &screen_lock );
+    return hwnd;
+}
+
+static void send_mouse( HWND hwnd, DWORD flags, INT x, INT y )
+{
+    INPUT input = {.type = INPUT_MOUSE};
+
+    input.mi.dx = x;
+    input.mi.dy = y;
+    input.mi.dwFlags = flags;
+    NtUserSendHardwareInput( hwnd, 0, &input, 0 );
+}
+
+static BOOL ps5_ProcessEvents( DWORD mask )
+{
+    static const DWORD button_flags[3][2] =
+    {
+        {MOUSEEVENTF_LEFTUP, MOUSEEVENTF_LEFTDOWN},
+        {MOUSEEVENTF_RIGHTUP, MOUSEEVENTF_RIGHTDOWN},
+        {MOUSEEVENTF_MIDDLEUP, MOUSEEVENTF_MIDDLEDOWN},
+    };
+    struct ps5_input event;
+    HWND hwnd = NtUserGetForegroundWindow();
+    UINT processed = 0;
+
+    if (!next_input) return FALSE;
+    if (!hwnd && (hwnd = last_shown_window()))
+    {
+        /* no window manager activates windows here: the newest one gets
+         * the foreground, so keyboard input has somewhere to go */
+        NtUserSetForegroundWindow( hwnd );
+    }
+    if (input_fd)
+    {
+        /* drain the wake pipe first: input posted from now on wakes again */
+        char buffer[64];
+        int fd = input_fd();
+        if (fd != -1) while (read( fd, buffer, sizeof(buffer) ) > 0) {}
+    }
+    while (processed < PS5_INPUT_BATCH && next_input( &event ))
+    {
+        INPUT input = {.type = INPUT_KEYBOARD};
+
+        processed++;
+        switch (event.type)
+        {
+        case 1:
+            input.ki.wVk = event.code;
+            input.ki.wScan = NtUserMapVirtualKeyEx( event.code, MAPVK_VK_TO_VSC, NtUserGetKeyboardLayout( 0 ));
+            input.ki.dwFlags = event.down ? 0 : KEYEVENTF_KEYUP;
+            NtUserSendHardwareInput( hwnd, 0, &input, 0 );
+            break;
+        case 2:
+            cursor.x = min( max( event.x, 0 ), (INT)screen_width - 1 );
+            cursor.y = min( max( event.y, 0 ), (INT)screen_height - 1 );
+            /* hardware input from a driver is absolute in screen pixels */
+            send_mouse( hwnd, MOUSEEVENTF_MOVE | MOUSEEVENTF_ABSOLUTE, cursor.x, cursor.y );
+            break;
+        case 3:
+            if (event.code < 3) send_mouse( hwnd, button_flags[event.code][event.down != 0], 0, 0 );
+            break;
+        }
+    }
+    return processed != 0;
+}
+
+static BOOL ps5_GetCursorPos( POINT *pos )
+{
+    *pos = cursor;
+    return TRUE;
+}
+
+static BOOL ps5_SetCursorPos( INT x, INT y )
+{
+    cursor.x = x;
+    cursor.y = y;
+    return TRUE;
+}
+
+static const struct user_driver_funcs ps5_user_driver =
+{
+    .pUpdateDisplayDevices = ps5_UpdateDisplayDevices,
+    .pCreateWindow = ps5_CreateWindow,
+    .pCreateWindowSurface = ps5_CreateWindowSurface,
+    .pWindowPosChanged = ps5_WindowPosChanged,
+    .pDestroyWindow = ps5_DestroyWindow,
+    .pProcessEvents = ps5_ProcessEvents,
+    .pGetCursorPos = ps5_GetCursorPos,
+    .pSetCursorPos = ps5_SetCursorPos,
+    .pSetDesktopWindow = ps5_SetDesktopWindow,
+};
+
+/***********************************************************************
+ *           ps5_install_user_driver
+ *
+ * WINE_PS5_DESKTOP=WxH overrides the 800x600 desktop.
+ */
+void ps5_install_user_driver(void)
+{
+    const char *size = getenv( "WINE_PS5_DESKTOP" );
+    unsigned int width, height;
+
+    if (size && sscanf( size, "%ux%u", &width, &height ) == 2 &&
+        width >= 320 && height >= 200 && width <= 3840 && height <= 2160)
+    {
+        screen_width = width;
+        screen_height = height;
+    }
+    if (!(screen = calloc( (size_t)screen_width * screen_height, sizeof(*screen) )))
+    {
+        ERR( "no memory for a %ux%u desktop\n", screen_width, screen_height );
+        return;
+    }
+    present_frame = dlsym( RTLD_DEFAULT, "pw_wine_present" );
+    next_input = dlsym( RTLD_DEFAULT, "pw_wine_next_input" );
+    input_fd = dlsym( RTLD_DEFAULT, "pw_wine_input_fd" );
+    if (!present_frame) WARN( "no pw_wine_present: frames are not shown\n" );
+    TRACE( "desktop %ux%u, present %p, input %p\n", screen_width, screen_height, present_frame, next_input );
+    __wine_set_user_driver( &ps5_user_driver, WINE_GDI_DRIVER_VERSION );
+}
+
+#endif  /* WINE_PS5_USER_DRIVER */
diff --git a/dlls/win32u/win32u_private.h b/dlls/win32u/win32u_private.h
index 5e3f7550a4..a5e331fcff 100644
--- a/dlls/win32u/win32u_private.h
+++ b/dlls/win32u/win32u_private.h
@@ -30,6 +30,12 @@
 #include "wine/gdi_driver.h"
 #include "wine/unixlib.h"
 #include "wine/debug.h"
+
+#if defined(__PROSPERO__) && !defined(WINE_PS5_USER_DRIVER)
+/* A PS5 title has no explorer and no display driver dll: win32u carries
+ * its own user driver (ps5drv.c) and the server creates the desktop. */
+#define WINE_PS5_USER_DRIVER 1
+#endif
 #include "wine/server.h"
 
 
diff --git a/dlls/win32u/winstation.c b/dlls/win32u/winstation.c
index 3c55a80c5e..34950fa1f0 100644
--- a/dlls/win32u/winstation.c
+++ b/dlls/win32u/winstation.c
@@ -814,7 +814,11 @@ HWND get_desktop_window(void)
 
     SERVER_START_REQ( get_desktop_window )
     {
+#ifdef WINE_PS5_USER_DRIVER
+        req->force = TRUE;  /* no explorer: the server creates the desktop window */
+#else
         req->force = is_service;
+#endif
         if (!wine_server_call( req ))
         {
             thread_info->top_window = wine_server_ptr_handle( reply->top_window );
-- 
