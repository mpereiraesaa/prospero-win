@@ -582,6 +583,10 @@ NTSTATUS WINAPI wow64_NtQueryInformationProcess( UINT *args )
 
     switch (class)
     {
+    case PW_QPC_PROCESS_INFO:
+        /* Pointer-free and identical layout on both sides. Older providers
+         * reject this class and the client retains the ordinary QPC path. */
+        return NtQueryInformationProcess( handle, class, ptr, len, retlen );
     case ProcessBasicInformation:  /* PROCESS_BASIC_INFORMATION */
         if (len == sizeof(PROCESS_BASIC_INFORMATION32))
         {
diff --git a/include/winternl.h b/include/winternl.h
index 3a80f27..d45e9ea 100644
--- a/include/winternl.h
+++ b/include/winternl.h
@@ -2013,6 +2013,7 @@ typedef enum _PROCESSINFOCLASS {
 #ifdef __WINESRC__
     ProcessWineMakeProcessSystem = 1000,
     ProcessWineGrantAdminToken = 1002,
+    ProcessWineQpcAnchor = 0x50575101,
 #endif
 } PROCESSINFOCLASS;
 
