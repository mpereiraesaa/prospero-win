From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: prospero-win <prospero-win@invalid>
Date: Wed, 30 Sep 2026 12:00:00 +0200
Subject: [PATCH] win32u: Move the PS5 pointer by relative motion.

The title kept its own pointer and sent Wine absolute positions. A game
that moves the pointer itself (SetCursorPos) was overridden by the next
motion, and a pointer held against an edge sent nothing, so Warcraft
III's map did not scroll at the screen's edges. The title now sends the
mouse's and stick's motion, and the driver passes it to the server as a
relative move, as a mouse does: the server clips it to ClipCursor's
rectangle, reports motion against an edge, and keeps the one position
SetCursorPos also moves. The driver reads that position back to draw the
cursor, and stops the pointer at what a frame shows where that is less
than the screen.
---
 dlls/win32u/ps5drv.c | 73 +++++++++++++++++++++++++++++++++++-------
 1 file changed, 63 insertions(+), 10 deletions(-)

--- a/dlls/win32u/ps5drv.c
+++ b/dlls/win32u/ps5drv.c
@@ -67,7 +67,7 @@ struct ps5_input
 {
     UINT type;              /* 1 key, 2 mouse move, 3 mouse button */
     UINT code;              /* virtual key, or button 0 left 1 right 2 middle */
-    INT  x, y;              /* mouse move: absolute desktop position */
+    INT  x, y;              /* mouse move: relative motion in desktop pixels */
     UINT down;
 };
 
@@ -467,6 +467,66 @@ static void send_mouse( HWND hwnd, DWORD flags, INT x, INT y )
     NtUserSendHardwareInput( hwnd, 0, &input, 0 );
 }
 
+/* The pointer's position as the server keeps it, in screen coordinates. */
+static BOOL server_cursor_pos( POINT *pos )
+{
+    struct object_lock lock = OBJECT_LOCK_INIT;
+    const desktop_shm_t *desktop_shm;
+    NTSTATUS status;
+
+    while ((status = get_shared_desktop( &lock, &desktop_shm )) == STATUS_PENDING)
+    {
+        pos->x = desktop_shm->cursor.x;
+        pos->y = desktop_shm->cursor.y;
+    }
+    return !status;
+}
+
+/* delta along one axis from pos, stopped at a shown edge (low or high - 1)
+ * that is not the screen's own (0 or screen_high - 1) */
+static INT shown_motion( INT pos, INT delta, INT low, INT high, INT screen_high )
+{
+    if (delta < 0 && low > 0 && pos + delta < low) return min( low - pos, 0 );
+    if (delta > 0 && high < screen_high && pos + delta > high - 1) return max( high - 1 - pos, 0 );
+    return delta;
+}
+
+/* The title's mouse and stick move the pointer by relative motion, as a
+ * mouse does. The server keeps it inside ClipCursor's rectangle and still
+ * reports the motion (WM_INPUT, WM_MOUSEMOVE) while it is held against an
+ * edge, which is what scrolls a strategy game's map, and SetCursorPos moves
+ * the same pointer, as mouse look expects. Where a frame shows only part of
+ * the screen (one window, or a smaller display mode), it stops at what is
+ * shown. It starts in the middle of the first frame. */
+static void move_cursor( HWND hwnd, INT dx, INT dy )
+{
+    static BOOL placed;
+    RECT shown;
+    POINT pos;
+
+    pthread_mutex_lock( &screen_lock );
+    shown = view;
+    pthread_mutex_unlock( &screen_lock );
+    if (!placed)
+    {
+        placed = TRUE;
+        send_mouse( hwnd, MOUSEEVENTF_MOVE | MOUSEEVENTF_ABSOLUTE, (shown.left + shown.right) / 2,
+                    (shown.top + shown.bottom) / 2 );
+    }
+    if (!server_cursor_pos( &pos )) return;
+    dx = shown_motion( pos.x, dx, shown.left, shown.right, screen_width );
+    dy = shown_motion( pos.y, dy, shown.top, shown.bottom, screen_height );
+    if (dx || dy) send_mouse( hwnd, MOUSEEVENTF_MOVE, dx, dy );
+    if (!server_cursor_pos( &pos )) return;
+    pthread_mutex_lock( &screen_lock );
+    if (cursor.x != pos.x || cursor.y != pos.y)
+    {
+        cursor = pos;
+        if (cursor_image) present_screen();     /* the pointer moved on screen */
+    }
+    pthread_mutex_unlock( &screen_lock );
+}
+
 static BOOL ps5_ProcessEvents( DWORD mask )
 {
     static const DWORD button_flags[3][2] =
@@ -507,14 +567,7 @@ static BOOL ps5_ProcessEvents( DWORD mask )
             NtUserSendHardwareInput( hwnd, 0, &input, 0 );
             break;
         case 2:
-            pthread_mutex_lock( &screen_lock );
-            /* the title's pointer moves over what the last frame showed */
-            cursor.x = view.left + min( max( event.x, 0 ), (INT)(view.right - view.left) - 1 );
-            cursor.y = view.top + min( max( event.y, 0 ), (INT)(view.bottom - view.top) - 1 );
-            if (cursor_image) present_screen();     /* the pointer moved on screen */
-            pthread_mutex_unlock( &screen_lock );
-            /* hardware input from a driver is absolute in screen pixels */
-            send_mouse( hwnd, MOUSEEVENTF_MOVE | MOUSEEVENTF_ABSOLUTE, cursor.x, cursor.y );
+            move_cursor( hwnd, event.x, event.y );
             break;
         case 3:
             if (event.code < 3) send_mouse( hwnd, button_flags[event.code][event.down != 0], 0, 0 );
@@ -663,7 +716,7 @@ static void ps5_SetCursor( HWND hwnd, HCURSOR handle )
 
 static BOOL ps5_GetCursorPos( POINT *pos )
 {
-    *pos = cursor;
+    /* the server's position is the pointer's: every move goes through it */
     return TRUE;
 }
 
