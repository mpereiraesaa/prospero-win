Subject: win32u: register guest windows by opaque generation-checked identity

Native service requests resolve guest HWNDs inside the driver only.

diff --git a/dlls/win32u/ntuser_private.h b/dlls/win32u/ntuser_private.h
--- a/dlls/win32u/ntuser_private.h
+++ b/dlls/win32u/ntuser_private.h
@@ -241,6 +241,7 @@
 
 
 #ifdef WINE_PS5_USER_DRIVER
+extern ULONG_PTR ps5_bridge_guest_window_call( HWND hwnd, void *request );
 extern ULONG_PTR ps5_bridge_window_call( void *request, ULONG_PTR size );
 extern void ps5_bridge_surface_destroyed( UINT_PTR instance, UINT64 surface );
 #endif
diff --git a/dlls/win32u/sysparams.c b/dlls/win32u/sysparams.c
--- a/dlls/win32u/sysparams.c
+++ b/dlls/win32u/sysparams.c
@@ -7704,6 +7704,14 @@
 
 ULONG_PTR WINAPI NtUserCallTwoParam( ULONG_PTR arg1, ULONG_PTR arg2, ULONG code )
 {
+    if (code == 0x50570021)
+    {
+#ifdef WINE_PS5_USER_DRIVER
+        return ps5_bridge_guest_window_call( UlongToHandle(arg1), (void *)arg2 );
+#else
+        return 1; /* PW_D3D9_WINDOW_INVALID: no PS5 association provider */
+#endif
+    }
     if (code == 0x50570020)
     {
 #ifdef WINE_PS5_USER_DRIVER
diff --git a/dlls/wow64win/user.c b/dlls/wow64win/user.c
--- a/dlls/wow64win/user.c
+++ b/dlls/wow64win/user.c
@@ -1801,6 +1801,10 @@
     ULONG_PTR arg2 = get_ulong( &args );
     ULONG code = get_ulong( &args );
 
+    /* Guest registration has a fixed 32-byte pointer-free request/reply.
+     * The HWND is local to this syscall; only the returned ID goes on wire. */
+    if (code == 0x50570021) return NtUserCallTwoParam( arg1, (UINT_PTR)UlongToPtr(arg2), code );
+
     /* Native local request contains handles/pointers and has no guest thunk. */
     if (code == 0x50570020) return 1; /* PW_D3D9_WINDOW_INVALID */
 
