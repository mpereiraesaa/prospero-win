+/* Session tokens are ownership/lifecycle identifiers, not a security boundary
+ * against arbitrary code already executing in this process. Never wrap/reuse. */
+static LONG64 native_session_serial;
+
+static ULONGLONG allocate_native_session(void)
+{
+    LONG64 old = InterlockedCompareExchange64( &native_session_serial, 0, 0 ), seen;
+    for (;;)
+    {
+        if (old == 0x7fffffffffffffffLL) return 0;
+        seen = InterlockedCompareExchange64( &native_session_serial, old + 1, old );
+        if (seen == old) return old + 1;
+        old = seen;
+    }
+}
+
 /***********************************************************************
  *              NtCreateThreadEx   (NTDLL.@)
  */
