+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "native_libkernel_resolver.h"
+#include <string.h>
+
+static uint64_t read64(const unsigned char *p)
+{
+    uint64_t v; memcpy(&v,p,sizeof(v)); return v;
+}
+static uint32_t read32(const unsigned char *p)
+{
+    uint32_t v; memcpy(&v,p,sizeof(v)); return v;
+}
+/* the kernel's struct sigaction: handler, flags, 128-bit mask */
+struct native_kernel_sigaction {
+    uintptr_t handler;
+    int flags;
+    uint32_t mask[4];
+};
+int native_libkernel_resolve(const void *record, size_t length, uintptr_t getppid_import,
+                             uintptr_t sysarch_import, const struct native_libkernel_ops *ops,
+                             struct native_libkernel_entries *entries)
+{
+    const unsigned char *info=record;
+    struct native_kernel_sigaction action;
+    uintptr_t entry, text=0, text_end=0;
+    uint32_t count;
+    if(!entries) return 0;
+    memset(entries,0,sizeof(*entries));
+    if(!info || length!=0x160 || !ops || !ops->syscall_at || !getppid_import || !sysarch_import) return 0;
+    if(read64(info)!=0 && read64(info)!=0x160) return 0;
+    /* the ELF loader's libkernel is a different module and is not supported */
+    if(memcmp(info+8,"libkernel.sprx",sizeof("libkernel.sprx"))) return 0;
+    count=read32(info+0x148);
+    if(!count || count>4) return 0;
+    entry=getppid_import+NATIVE_LIBKERNEL_STUB_SYSCALL;
+    for(unsigned i=0;i<count;i++)
+    {
+        const unsigned char *s=info+0x108+i*16;
+        uint64_t start=read64(s), size=read32(s+8);
+        if(!(read32(s+12)&4) || start>UINTPTR_MAX-size) continue;
+        if(getppid_import>=start && entry+2<=start+size) { text=start; text_end=start+size; }
+    }
+    if(!text) return 0;
+    /* the instruction runs whichever call is in %rax: getpid and getppid
+     * swapped, which only a real syscall instruction can answer */
+    if(ops->pid<=0 || ops->ppid<0 || ops->pid==ops->ppid) return 0;
+    if(ops->syscall_at(entry,NATIVE_LIBKERNEL_SYS_GETPID,0,0,0)!=ops->pid ||
+       ops->syscall_at(entry,NATIVE_LIBKERNEL_SYS_GETPPID,0,0,0)!=ops->ppid) return 0;
+    /* a raw sigaction query sees the kernel's registration: none, or
+     * libkernel's own entry when its wrapper installed a handler */
+    memset(&action,0,sizeof(action));
+    if(ops->syscall_at(entry,NATIVE_LIBKERNEL_SYS_SIGACTION,11 /* SIGSEGV */,0,(long)(uintptr_t)&action)) return 0;
+    if(action.handler>1 && (action.handler<text || action.handler>=text_end)) return 0;
+    entries->syscall=entry;
+    entries->sysarch=sysarch_import;
+    return 1;
+}
