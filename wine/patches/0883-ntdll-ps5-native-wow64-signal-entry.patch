+static void pw_native_resolve_kernel(void)
+{
+    unsigned char info[0x160] = {0};
+    uint64_t size = sizeof(info);
+    struct native_libkernel_ops ops = { pw_native_syscall_at, getpid(), getppid() };
+    memcpy( info, &size, sizeof(size) );
+    if (sceKernelGetModuleInfo( 0x2001, info )) return;
+    native_libkernel_resolve( info, sizeof(info), (uintptr_t)getppid,
+                              (uintptr_t)sysarch, &ops, &pw_native_kernel );
+}
+static int pw_native_sigaction( int signal, const struct sigaction *action,
+                                struct sigaction *previous )
+{
