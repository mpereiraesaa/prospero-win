+        return pw_native_syscall_at( pw_native_kernel.syscall, NATIVE_LIBKERNEL_SYS_SIGACTION,
+                                     signal, (long)action, (long)previous );
+    return sigaction( signal, action, previous );
+}
+#else
+#define pw_native_sigaction sigaction
+#endif
