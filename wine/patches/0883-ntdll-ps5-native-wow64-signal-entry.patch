+ * libkernel (the kernel refuses one anywhere else). The stub's own error
+ * path follows it, so a failure returns -1 with errno set. */
+extern long pw_native_syscall_at( uintptr_t entry, long number, long a1, long a2, long a3 );
+__ASM_GLOBAL_FUNC( pw_native_syscall_at,
+                   "movq %rsi,%rax\n\t"
+                   "movq %rdi,%r11\n\t"
+                   "movq %rdx,%rdi\n\t"
