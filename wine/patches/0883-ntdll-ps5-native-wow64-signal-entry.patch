+#ifdef __PROSPERO__
+/* The proven ordinary-title frame has a standard 64-byte header and
+ * 256 bytes of YMM upper halves. Do not advertise Wine allocation padding
+ * or features that the kernel frame cannot contain. */
+static unsigned int pw_native_signal_xstate_size( const XSAVE_AREA_HEADER *xs )
+{
+    if ((user_shared_data->XState.EnabledFeatures & ~(UINT64)7) ||
+        (xs->Mask & ~(UINT64)7) || xs->CompactionMask) return 0;
+    if (user_shared_data->XState.Features[2].Offset != 576 ||
+        user_shared_data->XState.Features[2].Size != 256 || xstate_size < 320) return 0;
+    return 320;
+}
+
+/* The signal frame offsets above were measured on one firmware. Before
+ * relying on them, take one signal through a raw registration and check
+ * that the frame holds this thread's MXCSR and FS base where FPU_sig and
+ * FSBASE_sig read them; otherwise the imported signal path is kept. */
+static volatile int pw_frame_hits;
+static volatile UINT pw_frame_mxcsr;
+static volatile UINT64 pw_frame_fsbase;
+
+static void pw_native_frame_handler( int signal, siginfo_t *siginfo, void *sigcontext )
+{
+    pw_frame_mxcsr = ((XSAVE_FORMAT *)FPU_sig( (ucontext_t *)sigcontext ))->MxCsr;
+    pw_frame_fsbase = FSBASE_sig( (ucontext_t *)sigcontext );
+    pw_frame_hits++;
+}
+
+static BOOL pw_native_frame_verified(void)
+{
+    struct sigaction probe = {0}, previous = {0};
+    sigset_t unblock, mask;
+    UINT64 fsbase = 0;
+    UINT mxcsr, marked;
+    BOOL ok;
+
+    if (amd64_get_fsbase( &fsbase ) || !fsbase) return FALSE;
+    probe.sa_sigaction = pw_native_frame_handler;
+    probe.sa_flags = SA_SIGINFO;
+    sigemptyset( &probe.sa_mask );
+    if (pw_native_sigaction( SIGUSR2, &probe, &previous ) == -1) return FALSE;
+    sigemptyset( &unblock );
+    sigaddset( &unblock, SIGUSR2 );
+    pthread_sigmask( SIG_UNBLOCK, &unblock, &mask );
+    __asm__ volatile( "stmxcsr %0" : "=m"(mxcsr) );
+    marked = (mxcsr & ~0x6000) | 0x2000;  /* round down: visible and harmless */
+    __asm__ volatile( "ldmxcsr %0" :: "m"(marked) );
+    pthread_kill( pthread_self(), SIGUSR2 );
+    __asm__ volatile( "ldmxcsr %0" :: "m"(mxcsr) );
+    pthread_sigmask( SIG_SETMASK, &mask, NULL );
+    pw_native_sigaction( SIGUSR2, &previous, NULL );
+    ok = pw_frame_hits == 1 && pw_frame_mxcsr == marked && pw_frame_fsbase == fsbase;
+    if (!ok)
+        ERR_(seh)( "PW_NATIVE_FRAME unverified hits=%d mxcsr=%#x/%#x fsbase=%#llx/%#llx\n", pw_frame_hits,
+                   pw_frame_mxcsr, marked, (unsigned long long)pw_frame_fsbase, (unsigned long long)fsbase );
+    return ok;
+}
+
+static unsigned int pw_native_ready_caps(void)
+{
+    XSAVE_AREA_HEADER standard = {0};
+    if (!pw_native_kernel.syscall || !pw_native_kernel.sysarch)
+        return 0;
+    if (cs64_sel != 0x43 || ds64_sel != 0x3b ||
+        user_shared_data->XState.EnabledFeatures != 7 ||
+        !pw_native_signal_xstate_size( &standard )) return 0;
+    return 7; /* raw entries, host FS before C, corrected FP/xstate context */
+}
