From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: prospero-win <prospero-win@invalid>
Date: Wed, 21 Oct 2026 20:00:00 +0200
Subject: [PATCH] win32u: Forward PS5 vertical mouse wheel input.

The title already reads signed wheel detents but discarded them. Input
kind 4 carries those detents in x without changing the shared ABI layout.
Send real mouse wheel hardware input so Windows messages and raw input
use Wine's normal path, including when the mouse has not moved.

Public contract: MOUSEINPUT uses MOUSEEVENTF_WHEEL and WHEEL_DELTA (120)
units per detent, with positive values scrolling forward/up.
https://learn.microsoft.com/en-us/windows/win32/api/winuser/ns-winuser-mouseinput
---
diff --git a/dlls/win32u/ps5drv.c b/dlls/win32u/ps5drv.c
--- a/dlls/win32u/ps5drv.c
+++ b/dlls/win32u/ps5drv.c
@@ -65,7 +65,7 @@
 /* the layout of PwWineInput in wine/ps5/pw_wine_sink.h */
 struct ps5_input
 {
-    UINT type;              /* 1 key, 2 mouse move, 3 mouse button */
+    UINT type;              /* 1 key, 2 mouse move, 3 mouse button, 4 wheel */
     UINT code;              /* virtual key, or button 0 left 1 right 2 middle */
     INT  x, y;              /* mouse move: relative motion in desktop pixels */
     UINT down;
@@ -457,6 +457,17 @@
     return hwnd;
 }
 
+/* Windows wheel messages carry a signed 16-bit delta; cap a single poll
+ * before multiplying so rapid free-spin or a corrupt report cannot wrap. */
+static void send_wheel( HWND hwnd, INT ticks )
+{
+    INPUT input = {.type = INPUT_MOUSE};
+
+    input.mi.dwFlags = MOUSEEVENTF_WHEEL;
+    input.mi.mouseData = (DWORD)(min( max( ticks, -273 ), 273 ) * WHEEL_DELTA);
+    NtUserSendHardwareInput( hwnd, 0, &input, 0 );
+}
+
 static void send_mouse( HWND hwnd, DWORD flags, INT x, INT y )
 {
     INPUT input = {.type = INPUT_MOUSE};
@@ -573,6 +584,9 @@
             break;
         case 3:
             if (event.code < 3) send_mouse( hwnd, button_flags[event.code][event.down != 0], 0, 0 );
+            break;
+        case 4:
+            if (event.x) send_wheel( hwnd, event.x );
             break;
         }
     }
