                     int flags, abstime_t when )
 {
@@ -1070,8 +1177,10 @@ static int wait_on( const union select_op *select_op, unsigned int count, struct
     wait->cookie  = 0;
     wait->user    = NULL;
     wait->when = when;
+    wait->start = monotonic_time;
     wait->abandoned = 0;
     current->wait = wait;
+    start_wait_watchdog();
 
     for (i = 0, entry = wait->queues; i < count; i++, entry++)
     {
--- a/server/thread.h
+++ b/server/thread.h
