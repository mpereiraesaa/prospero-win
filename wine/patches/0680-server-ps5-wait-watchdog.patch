+extern void dump_fd_state( struct fd *fd );
+
+/* WINE_PS5_WAIT_WATCHDOG: every async of a process that has not completed */
+void dump_process_asyncs( struct process *process )
+{
+    struct async *async;
+
+    LIST_FOR_EACH_ENTRY( async, &process->asyncs, struct async, process_entry )
+    {
+        fprintf( stderr, "wine-ps5: async tid=%04x initial=%08x iosb=%08x pending=%u signaled=%u alerted=%u "
+                 "terminated=%u unknown=%u blocking=%u system=%u queued=%u comp=%u",
+                 async->thread ? async->thread->id : 0, async->initial_status,
+                 async->iosb ? async->iosb->status : 0, async->pending, async->signaled, async->alerted,
+                 async->terminated, async->unknown_status, async->blocking, async->is_system,
+                 async->queue != NULL, async->completion != NULL );
+        dump_fd_state( async->fd );
+        fprintf( stderr, "\n" );
+    }
+}
