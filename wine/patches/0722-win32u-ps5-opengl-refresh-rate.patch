From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: prospero-win <prospero-win@invalid>
Date: Thu, 1 Oct 2026 14:30:00 +0200
Subject: [PATCH] win32u: Let a PS5 OpenGL game ask for 120 Hz output.

WINE_PS5_GL_REFRESH=120, set by the title from a game profile's
[display] refresh, calls the OpenGL SDK's eglSetDisplayRefreshPS5()
before EGL starts. Only SDKs built with runtime display modes offer it,
the console grants 120 Hz only to titles that declare the capability, and
a display without 120 Hz keeps presenting at 60.
---
 dlls/win32u/opengl.c | 23 +++++++++++++++++++++--
 1 file changed, 21 insertions(+), 2 deletions(-)

diff --git a/dlls/win32u/opengl.c b/dlls/win32u/opengl.c
index f64d669727..29b145985f 100644
--- a/dlls/win32u/opengl.c
+++ b/dlls/win32u/opengl.c
@@ -1724,8 +1724,27 @@ static BOOL egl_init( const struct opengl_driver_funcs **driver_funcs )
     funcs->p_eglQuerySurface = eglQuerySurface;
     funcs->p_eglSwapBuffers = eglSwapBuffers;
     funcs->p_eglTerminate = eglTerminate;
-    if (!(display = eglGetDisplay( EGL_DEFAULT_DISPLAY )) ||
-        !eglInitialize( display, &major, &minor ))
+    if (!(display = eglGetDisplay( EGL_DEFAULT_DISPLAY )))
+    {
+        ERR( "Failed to get the PS5 EGL display\n" );
+        return FALSE;
+    }
+    {
+        /* WINE_PS5_GL_REFRESH=120 (a profile's [display] refresh) asks the
+         * SDK for 120 Hz output before EGL starts. Only an SDK built with
+         * runtime display modes offers it; the console grants it only to a
+         * title declaring the capability, and a display without 120 Hz keeps
+         * presenting at 60. */
+        const char *refresh = getenv( "WINE_PS5_GL_REFRESH" );
+        EGLBoolean (*set_refresh)( EGLDisplay, EGLint ) = (void *)eglGetProcAddress( "eglSetDisplayRefreshPS5" );
+
+        if (refresh && atoi( refresh ) == 120)
+        {
+            if (!set_refresh) WARN( "this OpenGL SDK cannot change the refresh rate\n" );
+            else if (!set_refresh( display, 120 )) WARN( "120 Hz refused, error %#x\n", eglGetError() );
+        }
+    }
+    if (!eglInitialize( display, &major, &minor ))
     {
         ERR( "Failed to initialize the PS5 EGL display\n" );
         return FALSE;
