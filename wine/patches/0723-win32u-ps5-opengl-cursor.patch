From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: prospero-win <prospero-win@invalid>
Date: Thu, 1 Oct 2026 16:00:00 +0200
Subject: [PATCH] win32u: Draw the cursor over PS5 OpenGL frames.

The PS5 user driver draws the application's cursor over the frames it
composes (patch 0420), but an OpenGL window's frames reach the screen
through the SDK's EGL surface, so a game's menu showed no pointer: its
items lit up under an invisible cursor. The presenter now blends the
cursor the application set, straight-alpha ARGB from the user driver,
over each OpenGL frame at the pointer's place, scaled as the frame is.
A hidden cursor (a game in mouse look) is not drawn.
---
 dlls/win32u/opengl.c | 80 ++++++++++++++++++++++++++++++++++++++++++++
 dlls/win32u/ps5drv.c | 19 +++++++++++
 2 files changed, 99 insertions(+)

diff --git a/dlls/win32u/opengl.c b/dlls/win32u/opengl.c
index 29b1459..51b94e1 100644
--- a/dlls/win32u/opengl.c
+++ b/dlls/win32u/opengl.c
@@ -951,6 +951,85 @@ static EGLSurface ps5_get_screen_surface( int format )
 }
 #endif
 
+#ifdef WINE_PS5_OPENGL
+extern const UINT32 *ps5drv_lock_cursor( UINT *width, UINT *height, POINT *top_left );
+extern void ps5drv_unlock_cursor(void);
+
+/* The PS5 has no display server to draw the pointer over an OpenGL frame,
+ * and the user driver only draws it over GDI frames: blend the cursor the
+ * application set onto the presented frame, scaled as the frame is. */
+static void draw_ps5_cursor( const struct opengl_funcs *funcs, struct opengl_drawable *drawable,
+                             SIZE src, SIZE dst, POINT origin, EGLint width, EGLint height )
+{
+    const UINT32 *image;
+    UINT cursor_width, cursor_height;
+    POINT top_left, client = {0, 0};
+    float x0, y0, x1, y1;
+    GLuint texture;
+
+    if (!drawable->client || !client_to_screen( drawable->client->hwnd, &client )) return;
+    if (!(image = ps5drv_lock_cursor( &cursor_width, &cursor_height, &top_left )) || !cursor_width || !cursor_height)
+    {
+        ps5drv_unlock_cursor();
+        return;
+    }
+    funcs->p_glGenTextures( 1, &texture );
+    funcs->p_glBindTexture( GL_TEXTURE_2D, texture );
+    funcs->p_glTexParameteri( GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR );
+    funcs->p_glTexParameteri( GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR );
+    funcs->p_glTexParameteri( GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE );
+    funcs->p_glTexParameteri( GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE );
+    funcs->p_glPixelStorei( GL_UNPACK_ALIGNMENT, 4 );
+    {
+        /* RGBA bytes: the SDK drew nothing from a GL_BGRA upload, without an error */
+        UINT count = cursor_width * cursor_height, i;
+        BYTE *rgba = malloc( count * 4 );
+
+        for (i = 0; rgba && i < count; i++)
+        {
+            rgba[i * 4 + 0] = image[i] >> 16;
+            rgba[i * 4 + 1] = image[i] >> 8;
+            rgba[i * 4 + 2] = image[i];
+            rgba[i * 4 + 3] = image[i] >> 24;
+        }
+        ps5drv_unlock_cursor();
+        if (!rgba)
+        {
+            funcs->p_glDeleteTextures( 1, &texture );
+            return;
+        }
+        funcs->p_glTexImage2D( GL_TEXTURE_2D, 0, GL_RGBA, cursor_width, cursor_height, 0, GL_RGBA,
+                               GL_UNSIGNED_BYTE, rgba );
+        free( rgba );
+    }
+
+    /* screen -> frame pixels -> the frame's place on the TV, in NDC */
+    x0 = origin.x + (float)(top_left.x - client.x) * dst.cx / src.cx;
+    y0 = origin.y + (float)(top_left.y - client.y) * dst.cy / src.cy;
+    x1 = x0 + (float)cursor_width * dst.cx / src.cx;
+    y1 = y0 + (float)cursor_height * dst.cy / src.cy;
+    x0 = 2.0f * x0 / width - 1.0f;
+    x1 = 2.0f * x1 / width - 1.0f;
+    y0 = 1.0f - 2.0f * y0 / height;
+    y1 = 1.0f - 2.0f * y1 / height;
+
+    funcs->p_glViewport( 0, 0, width, height );
+    funcs->p_glEnable( GL_TEXTURE_2D );
+    funcs->p_glTexEnvi( GL_TEXTURE_ENV, GL_TEXTURE_ENV_MODE, GL_REPLACE );
+    funcs->p_glEnable( GL_BLEND );
+    funcs->p_glBlendFunc( GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA );
+    funcs->p_glBegin( GL_TRIANGLE_STRIP );
+    funcs->p_glTexCoord2f( 0.0f, 1.0f ); funcs->p_glVertex2f( x0, y1 );
+    funcs->p_glTexCoord2f( 0.0f, 0.0f ); funcs->p_glVertex2f( x0, y0 );
+    funcs->p_glTexCoord2f( 1.0f, 1.0f ); funcs->p_glVertex2f( x1, y1 );
+    funcs->p_glTexCoord2f( 1.0f, 0.0f ); funcs->p_glVertex2f( x1, y0 );
+    funcs->p_glEnd();
+    funcs->p_glDisable( GL_BLEND );
+    funcs->p_glDisable( GL_TEXTURE_2D );
+    funcs->p_glDeleteTextures( 1, &texture );
+}
+#endif
+
 static void blit_framebuffer_surface( struct opengl_drawable *drawable )
 {
     static pthread_once_t once = PTHREAD_ONCE_INIT;
@@ -1029,6 +1108,7 @@ static void blit_framebuffer_surface( struct opengl_drawable *drawable )
         funcs->p_glTexCoord2f( 1.0f, 1.0f ); funcs->p_glVertex2f(  1.0f,  1.0f );
         funcs->p_glEnd();
         funcs->p_glDisable( GL_TEXTURE_2D );
+        draw_ps5_cursor( funcs, drawable, src, dst, origin, width, height );
     }
     else
 #endif
diff --git a/dlls/win32u/ps5drv.c b/dlls/win32u/ps5drv.c
index cec1b14..c7d6f18 100644
--- a/dlls/win32u/ps5drv.c
+++ b/dlls/win32u/ps5drv.c
@@ -719,6 +719,25 @@ static void ps5_SetCursor( HWND hwnd, HCURSOR handle )
     TRACE( "cursor %p: %ux%u\n", handle, width, height );
 }
 
+/* For OpenGL frames, which reach the screen without this driver's
+ * composition: the cursor image (straight-alpha ARGB, NULL when hidden),
+ * its size and where its top-left corner is on the screen. The image stays
+ * valid until ps5drv_unlock_cursor(). */
+const UINT32 *ps5drv_lock_cursor( UINT *width, UINT *height, POINT *top_left )
+{
+    pthread_mutex_lock( &screen_lock );
+    *width = cursor_width;
+    *height = cursor_height;
+    top_left->x = cursor.x - cursor_hotspot.x;
+    top_left->y = cursor.y - cursor_hotspot.y;
+    return cursor_image;
+}
+
+void ps5drv_unlock_cursor(void)
+{
+    pthread_mutex_unlock( &screen_lock );
+}
+
 static BOOL ps5_GetCursorPos( POINT *pos )
 {
     /* the server's position is the pointer's: every move goes through it */
