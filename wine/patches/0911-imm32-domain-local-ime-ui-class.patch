Subject: imm32: keep the builtin IME UI class local to each callback domain

--- a/dlls/imm32/ime.c
+++ b/dlls/imm32/ime.c
@@ -470,10 +470,15 @@
     return DefWindowProcW( hwnd, msg, wparam, lparam );
 }
 
+/* Not CS_GLOBALCLASS: a WoW64 process with native service threads loads a
+ * guest and a native imm32 that both register this name. A global class is
+ * matched for any instance, so the second registration fails and the other
+ * domain's procedure is used. imm32 creates the UI window with its own module,
+ * which selects this domain's instance-local class. */
 static WNDCLASSEXW ime_ui_class =
 {
     .cbSize = sizeof(WNDCLASSEXW),
-    .style = CS_GLOBALCLASS | CS_IME | CS_HREDRAW | CS_VREDRAW,
+    .style = CS_IME | CS_HREDRAW | CS_VREDRAW,
     .lpfnWndProc = ime_ui_window_proc,
     .cbWndExtra = 2 * sizeof(LONG_PTR),
     .lpszClassName = L"Wine IME",
