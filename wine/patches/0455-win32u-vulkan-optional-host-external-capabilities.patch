From 5a2ea5182dc6250bcda730da6e671c9202f85285 Mon Sep 17 00:00:00 2001
From: Manuel Pereira <manuelpereiralds@gmail.com>
Date: Mon, 28 Sep 2026 19:53:28 +0200
Subject: [PATCH] win32u: Request external memory, semaphore and fence
 capabilities only from hosts that have them.

The instance always asked the host for VK_KHR_external_semaphore_capabilities,
which it uses for keyed mutexes, and in WoW64 processes for
VK_KHR_external_memory_capabilities; win32u's own D3DKMT instance asked for
VK_KHR_external_fence_capabilities. A Vulkan 1.0 host without them, like the
PS5's driver, then refused every instance with VK_ERROR_EXTENSION_NOT_PRESENT.
Without them a 32-bit process still needs VK_EXT_map_memory_placed or
VK_EXT_external_memory_host to map device memory below 4 GiB.
---
 dlls/win32u/vulkan.c | 15 ++++++++++-----
 1 file changed, 10 insertions(+), 5 deletions(-)

diff --git a/dlls/win32u/vulkan.c b/dlls/win32u/vulkan.c
index 261c10cefc..10a3297aae 100644
--- a/dlls/win32u/vulkan.c
+++ b/dlls/win32u/vulkan.c
@@ -448,12 +448,14 @@ static VkResult convert_instance_create_info( struct mempool *pool, VkInstanceCr
         instance->obj.extensions.has_VK_EXT_surface_maintenance1 = 1;
     if (vulkan_funcs.host_extensions.has_VK_KHR_get_physical_device_properties2)
         instance->obj.extensions.has_VK_KHR_get_physical_device_properties2 = 1;
-    if (use_external_memory())
+    if (use_external_memory() && vulkan_funcs.host_extensions.has_VK_KHR_external_memory_capabilities)
         instance->obj.extensions.has_VK_KHR_external_memory_capabilities = 1;
 
     /* VK_KHR_win32_keyed_mutex only requires external memory extensions, but we will use
-     * external semaphore fds to implement it, so we enable the instance extensions too */
-    instance->obj.extensions.has_VK_KHR_external_semaphore_capabilities = 1;
+     * external semaphore fds to implement it, so we enable the instance extensions too,
+     * when the host has them: a Vulkan 1.0 host without them still runs everything else */
+    if (vulkan_funcs.host_extensions.has_VK_KHR_external_semaphore_capabilities)
+        instance->obj.extensions.has_VK_KHR_external_semaphore_capabilities = 1;
 
     if (!(extensions = mem_alloc( pool, sizeof(instance->obj.extensions) * 8 * sizeof(*extensions) ))) return VK_ERROR_OUT_OF_HOST_MEMORY;
 #define USE_VK_EXT(x) if (instance->obj.extensions.has_ ## x) extensions[count++] = #x;
@@ -3163,14 +3165,17 @@ struct vulkan_instance *vulkan_instance_create( const struct vulkan_instance_ext
     const struct vulkan_funcs *funcs = __wine_get_vulkan_driver( WINE_VULKAN_DRIVER_VERSION );
     VkInstanceCreateInfo create_info = {.sType = VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO};
     const char *extension_names[sizeof(*extensions) * 8];
+    struct vulkan_instance_extensions enabled = {0};
     struct instance_wrapper *wrapper;
     UINT device_count = 8;
     VkResult res;
 
     if (!funcs) return NULL;
 
+    /* what the host lacks is left out rather than failing the instance */
     create_info.ppEnabledExtensionNames = extension_names;
-#define USE_VK_EXT(x) if (extensions->has_ ## x) extension_names[create_info.enabledExtensionCount++] = #x;
+#define USE_VK_EXT(x) if (extensions->has_ ## x && funcs->client_extensions.has_ ## x) \
+    { enabled.has_ ## x = 1; extension_names[create_info.enabledExtensionCount++] = #x; }
     ALL_VK_INSTANCE_EXTS
 #undef USE_VK_EXT
 
@@ -3180,7 +3185,7 @@ struct vulkan_instance *vulkan_instance_create( const struct vulkan_instance_ext
 
         if (!(wrapper = calloc( 1, offsetof(struct instance_wrapper, client.physical_device[device_count]) ))) return NULL;
         wrapper->client.physical_device_count = device_count;
-        wrapper->client.extensions = *extensions;
+        wrapper->client.extensions = enabled;
         instance = &wrapper->client;
 
         if ((res = funcs->p_vkCreateInstance( &create_info, NULL, &instance ))) break;
