--- a/dlls/ntdll/signal_x86_64.c
+++ b/dlls/ntdll/signal_x86_64.c
@@ -416,6 +416,18 @@
                    "int3" )
 
 
+/* The PE64 user32 table and WoW64 marshal table coexist in a native
+ * service process. Never select callback ABI using process-global PEB state. */
+void **pw_wow64_callback_table;
+
+NTSTATUS WINAPI __wine_register_wow64_callbacks( void **table )
+{
+    void *previous;
+    if (!table) return STATUS_INVALID_PARAMETER;
+    previous = InterlockedCompareExchangePointer( (void **)&pw_wow64_callback_table, table, NULL );
+    return !previous || previous == table ? STATUS_SUCCESS : STATUS_INVALID_PARAMETER;
+}
+
