From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: orbis-win <orbis-win@invalid>
Subject: [PATCH] quartz, l3codecx: Play MPEG audio files without GStreamer.

prospero-win builds Wine --without-gstreamer, so winegstreamer does not exist,
but quartz's MPEG-I Stream Splitter and l3codecx's MPEG Layer-3 Decoder are
only wrappers around winegstreamer classes. No .mp3 can be rendered through
DirectShow, although mp3dmod decodes MP3 with Wine's bundled mpg123: the
filter graph fails with "Failed to create filter for MPEG-I Stream Splitter,
hr 0x80040154". Games that play their music this way lose it, and some retry
forever: The Elder Scrolls IV: Oblivion leaks a file handle per retry and dies
after a few minutes (https://bugs.winehq.org/show_bug.cgi?id=19967).

When the winegstreamer class cannot be created:
- quartz falls back to mpegaudiosplit.c, an elementary MPEG-1/2/2.5 audio
  splitter: ID3v2 and ID3v1 skipped, the Xing/Info frame count read for the
  duration, whole frames delivered with timestamps on one "Audio" pin
  (MEDIASUBTYPE_MP3 for Layer III, MPEG1AudioPayload otherwise), seeking by
  walking frames. MPEG system streams (audio and video multiplexed) are not
  handled and still need winegstreamer.
- l3codecx hosts mp3dmod in the DMO Wrapper filter, the standard way to use a
  DMO in DirectShow.
A Wine with GStreamer is unaffected: the winegstreamer classes are tried first.
---
diff --git a/dlls/l3codecx.ax/l3codecx.c b/dlls/l3codecx.ax/l3codecx.c
index 6ebf80e2cc..89d463a705 100644
--- a/dlls/l3codecx.ax/l3codecx.c
+++ b/dlls/l3codecx.ax/l3codecx.c
@@ -24,6 +24,9 @@
 #include "winbase.h"
 
 #include "dshow.h"
+#include "dmodshow.h"
+#include "dmoreg.h"
+#include "wmcodecdsp.h"
 #include "mpegtype.h"
 #include "rpcproxy.h"
 
@@ -49,11 +52,42 @@ static inline ULONG WINAPI class_factory_Release(IClassFactory *iface)
 {
     return 1;
 }
+/* Without winegstreamer (a Wine built without GStreamer) there is no
+ * wg_mp3_decoder, but mp3dmod - Wine's MP3 DMO on its bundled mpg123 - is
+ * always there: host it in the DMO Wrapper filter, which is what a DMO is for
+ * in DirectShow. */
+static HRESULT create_dmo_decoder(IUnknown *outer, REFIID riid, void **out)
+{
+    IDMOWrapperFilter *wrapper;
+    IUnknown *unk;
+    HRESULT hr;
+
+    if (outer && !IsEqualGUID(riid, &IID_IUnknown))
+        return E_NOINTERFACE;
+    if (FAILED(hr = CoCreateInstance(&CLSID_DMOWrapperFilter, outer, CLSCTX_INPROC_SERVER,
+            &IID_IUnknown, (void **)&unk)))
+        return hr;
+    if (SUCCEEDED(hr = IUnknown_QueryInterface(unk, &IID_IDMOWrapperFilter, (void **)&wrapper)))
+    {
+        hr = IDMOWrapperFilter_Init(wrapper, &CLSID_CMP3DecMediaObject, &DMOCATEGORY_AUDIO_DECODER);
+        IDMOWrapperFilter_Release(wrapper);
+    }
+    if (SUCCEEDED(hr))
+        hr = IUnknown_QueryInterface(unk, riid, out);
+    IUnknown_Release(unk);
+    return hr;
+}
+
 static HRESULT WINAPI mpeg_layer3_decoder_factory_CreateInstance(IClassFactory *iface,
         IUnknown *outer, REFIID riid, void **out)
 {
     static const GUID CLSID_wg_mp3_decoder = {0x84cd8e3e,0xb221,0x434a,{0x88,0x82,0x9d,0x6c,0x8d,0xf4,0x90,0xe1}};
-    return CoCreateInstance(&CLSID_wg_mp3_decoder, outer, CLSCTX_INPROC_SERVER, riid, out);
+    HRESULT hr;
+
+    if (SUCCEEDED(hr = CoCreateInstance(&CLSID_wg_mp3_decoder, outer, CLSCTX_INPROC_SERVER, riid, out)))
+        return hr;
+    TRACE("winegstreamer's MP3 decoder is unavailable, hr %#lx; using mp3dmod.\n", hr);
+    return create_dmo_decoder(outer, riid, out);
 }
 static inline HRESULT WINAPI class_factory_LockServer(IClassFactory *iface, BOOL dolock)
 {
diff --git a/dlls/quartz/Makefile.in b/dlls/quartz/Makefile.in
index a61bbc2b5f..31885ac1dd 100644
--- a/dlls/quartz/Makefile.in
+++ b/dlls/quartz/Makefile.in
@@ -17,6 +17,7 @@ SOURCES = \
 	filtermapper.c \
 	main.c \
 	memallocator.c \
+	mpegaudiosplit.c \
 	parser.c \
 	passthrough.c \
 	quartz.rc \
diff --git a/dlls/quartz/mpegaudiosplit.c b/dlls/quartz/mpegaudiosplit.c
new file mode 100644
index 0000000000..2832569448
--- /dev/null
+++ b/dlls/quartz/mpegaudiosplit.c
@@ -0,0 +1,828 @@
+/*
+ * MPEG audio splitter used when winegstreamer is not available
+ *
+ * Copyright 2026 the orbis-win authors
+ *
