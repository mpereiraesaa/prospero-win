From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: prospero-win <prospero-win@invalid>
Date: Tue, 6 Oct 2026 16:30:00 +0200
Subject: [PATCH] ntdll: Clear decommitted pages that share a host page with
 committed ones.

Windows gives zeroed pages when decommitted memory is committed again.
Wine discards the decommitted range's host pages to get that, but with
host pages larger than Windows pages (16 KiB on the PS5) it cannot
discard a host page that also holds pages staying committed. Those
decommitted pages kept their old contents, and committing them again
returned the old bytes instead of zeroes.

Clear the committed pages being decommitted in such a partial host page,
with the host page made writable for the moment, then give each partial
host page the protection its remaining pages need. Nothing changes when
host and Windows pages are the same size. PS5_Proton found and fixed the
same gap (mihawk-99, its patch 0936).

  dlls/ntdll/unix/virtual.c | 39 ++++++++++++++++++++++++++++++++++-----
  1 file changed, 34 insertions(+), 5 deletions(-)

diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
index 403849b..4a37285 100644
--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -2763,20 +2763,49 @@ static SIZE_T get_committed_size( struct file_view *view, void *base, size_t max
  * Decommit some pages of a given view.
  * virtual_mutex must be held by caller.
  */
+static NTSTATUS clear_committed_pages( char *start, char *end )
+{
+    char *page;
+
+    for (page = start; page < end; page += page_size)
+    {
+        if (!(get_page_vprot( page ) & VPROT_COMMITTED)) continue;
+        if (mprotect_range( page, page_size, VPROT_READ | VPROT_WRITE, VPROT_GUARD | VPROT_WRITEWATCH ))
+            return STATUS_ACCESS_DENIED;
+        memset( page, 0, page_size );
+    }
+    return STATUS_SUCCESS;
+}
+
 static NTSTATUS decommit_pages( struct file_view *view, char *base, size_t size )
 {
-    char *host_end, *host_start = (char *)ROUND_SIZE( 0, base, host_page_mask );
+    char *end, *host_end, *host_start = (char *)ROUND_SIZE( 0, base, host_page_mask );
+    NTSTATUS status = STATUS_SUCCESS;
+
+    if (!size) size = view->size;
+    end = base + size;
+    host_end = ROUND_ADDR( end, host_page_mask );
 
-    if (!size)
+    /* A host page that also holds pages staying committed cannot be replaced,
+     * so the decommitted pages in it keep their contents, and committing them
+     * again would return those instead of zeroes. Clear them. */
+    if (host_start >= host_end) status = clear_committed_pages( base, end );
+    else
     {
-        size = view->size;
-        host_end = host_start + view->size;
+        status = clear_committed_pages( base, host_start );
+        if (!status) status = clear_committed_pages( host_end, end );
+    }
+    if (status)
+    {
+        mprotect_range( base, size, 0, 0 );
+        return status;
     }
-    else host_end = ROUND_ADDR( base + size, host_page_mask );
 
     if (host_start < host_end) anon_mmap_fixed( host_start, host_end - host_start, PROT_NONE, 0 );
     set_page_vprot_bits( base, size, 0, VPROT_COMMITTED );
     if (host_start < host_end) kernel_writewatch_register_range( view, host_start, host_end - host_start );
+    /* the partial host pages get the protection their remaining pages need */
+    if (host_page_mask != page_mask && mprotect_range( base, size, 0, 0 )) return STATUS_ACCESS_DENIED;
     return STATUS_SUCCESS;
 }
 
