From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Prospero Win <prospero-win@invalid>
Date: Wed, 30 Sep 2026 20:50:00 +0200
Subject: [PATCH] win32u: present PS5 OpenGL windows through the GL 2.1 path

The PS5 compatibility context offers GLSL 1.20, while Wine's internal
framebuffer blit shader requires GLSL 3.30 and uniform buffers. Its shader
fails to compile and the scaled window is black. Draw the attached color
texture with the compatibility pipeline on PS5. Preserve Wine's shader and
gamma path on other hosts.
---
diff --git a/dlls/win32u/opengl.c b/dlls/win32u/opengl.c
index bd4c0c54d3..c90083e41a 100644
--- a/dlls/win32u/opengl.c
+++ b/dlls/win32u/opengl.c
@@ -999,7 +999,40 @@
 #endif
     if (drawable->srgb) funcs->p_glEnable( GL_FRAMEBUFFER_SRGB );
 
-    if (!draw_quad && drawable->read_fbo == drawable->draw_fbo && use_default_gamma_ramp())
+#ifdef WINE_PS5_OPENGL
+    if (draw_quad)
+    {
+        GLint front;
+
+        /* The compatibility context supports textured fixed-function drawing,
+         * while Wine's framebuffer program requires GLSL 3.30 and UBOs. */
+        funcs->p_glActiveTexture( GL_TEXTURE0 );
+        funcs->p_glGetFramebufferAttachmentParameteriv( GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                                                       GL_FRAMEBUFFER_ATTACHMENT_OBJECT_NAME, &front );
+        funcs->p_glBindTexture( GL_TEXTURE_2D, front );
+        funcs->p_glTexParameteri( GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR );
+        funcs->p_glTexParameteri( GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR );
+        funcs->p_glUseProgram( 0 );
+        funcs->p_glEnable( GL_TEXTURE_2D );
+        funcs->p_glTexEnvi( GL_TEXTURE_ENV, GL_TEXTURE_ENV_MODE, GL_REPLACE );
+        funcs->p_glDisable( GL_DEPTH_TEST );
+        funcs->p_glDisable( GL_BLEND );
+        funcs->p_glViewport( origin.x, origin.y, dst.cx, dst.cy );
+        funcs->p_glMatrixMode( GL_PROJECTION );
+        funcs->p_glLoadIdentity();
+        funcs->p_glMatrixMode( GL_MODELVIEW );
+        funcs->p_glLoadIdentity();
+        funcs->p_glBegin( GL_TRIANGLE_STRIP );
+        funcs->p_glTexCoord2f( 0.0f, 0.0f ); funcs->p_glVertex2f( -1.0f, -1.0f );
+        funcs->p_glTexCoord2f( 0.0f, 1.0f ); funcs->p_glVertex2f( -1.0f,  1.0f );
+        funcs->p_glTexCoord2f( 1.0f, 0.0f ); funcs->p_glVertex2f(  1.0f, -1.0f );
+        funcs->p_glTexCoord2f( 1.0f, 1.0f ); funcs->p_glVertex2f(  1.0f,  1.0f );
+        funcs->p_glEnd();
+        funcs->p_glDisable( GL_TEXTURE_2D );
+    }
+    else
+#endif
+    if (drawable->read_fbo == drawable->draw_fbo && use_default_gamma_ramp())
     {
         funcs->p_glReadBuffer( GL_COLOR_ATTACHMENT0 );
         funcs->p_glBlitFramebuffer( 0, 0, src.cx, src.cy, origin.x, origin.y, origin.x + dst.cx, origin.y + dst.cy,
