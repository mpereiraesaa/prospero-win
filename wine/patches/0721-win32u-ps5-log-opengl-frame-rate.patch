From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: prospero-win <prospero-win@invalid>
Date: Thu, 1 Oct 2026 13:30:00 +0200
Subject: [PATCH] win32u: Log the frame rate of OpenGL games on the PS5.

wglSwapBuffers counts frames and, every five seconds, writes
"PW_GL frames=<n> fps=<rate>" to stderr, which the title forwards to its
log. The on-screen counter (show_fps) is only seen at the TV; this lets
an unattended run report how fast a game draws.
---
 dlls/win32u/opengl.c | 22 ++++++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/dlls/win32u/opengl.c b/dlls/win32u/opengl.c
index 5ffe9c7fa7..f64d669727 100644
--- a/dlls/win32u/opengl.c
+++ b/dlls/win32u/opengl.c
@@ -3224,6 +3224,25 @@ static BOOL win32u_context_flush( struct opengl_context *context, void (*flush)(
     return TRUE;
 }
 
+#ifdef WINE_PS5_OPENGL
+/* The frame rate of OpenGL games, once every five seconds in the log: the
+ * on-screen counter is only seen by whoever is at the TV. */
+static void log_frame_rate(void)
+{
+    static DWORD start, frames;
+    DWORD now = NtGetTickCount();
+
+    if (!frames++) start = now;
+    else if (now - start >= 5000)
+    {
+        fprintf( stderr, "PW_GL frames=%u fps=%.1f\n", (unsigned int)frames - 1,
+                 (frames - 1) * 1000.0 / (now - start) );
+        frames = 1;
+        start = now;
+    }
+}
+#endif
+
 static BOOL win32u_wglSwapBuffers( HDC hdc )
 {
     struct opengl_context *context = NtCurrentTeb()->glContext;
@@ -3247,6 +3266,9 @@ static BOOL win32u_wglSwapBuffers( HDC hdc )
     opengl_drawable_flush( draw, interval, 0 );
     ret = opengl_drawable_swap( draw );
     opengl_drawable_release( draw );
+#ifdef WINE_PS5_OPENGL
+    log_frame_rate();
+#endif
 
     return ret;
 }
