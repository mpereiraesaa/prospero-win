From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: prospero-win <prospero-win@invalid>
Date: Thu, 1 Oct 2026 13:00:00 +0200
Subject: [PATCH] opengl32: Batch immediate-mode and state calls on the client
 side.

Each OpenGL call crosses from the PE side to the Unix side, which under
WoW64 costs far more than the call: Half-Life draws with
glBegin/glVertex/glTexCoord/glColor/glEnd and makes about 25,000 calls a
frame, 75% of them per-vertex. Calls that only feed vertices and current
attributes, and return nothing, are now recorded in a per-thread batch
(array forms by value, since their memory may change) and replayed in
order on the Unix side, by one new call, before any other call reaches
it. glGetError, SwapBuffers and everything else therefore see the same
sequence of calls as before.

State calls that return nothing and take only values (texture binds,
enables, blending, depth, matrices, viewport and the like) are recorded the
same way. Counter-Strike 1.6 with bots issued about 300,000 of them a
second; batching them cut its Unix calls more than tenfold.
---
 dlls/opengl32/unix_thunks.c |   5 +
 dlls/opengl32/unix_wgl.c    |  41 ++++++++
 dlls/opengl32/unixlib.h     |  23 +++++
 dlls/opengl32/wgl.c         | 241 ++++++++++++++++++++++++++++++++++++
 4 files changed, 310 insertions(+)

diff --git a/dlls/opengl32/unix_thunks.c b/dlls/opengl32/unix_thunks.c
index 86d0d32e38..acb58cd11f 100644
--- a/dlls/opengl32/unix_thunks.c
+++ b/dlls/opengl32/unix_thunks.c
@@ -27925,6 +27925,8 @@ static NTSTATUS ext_wglSwapIntervalEXT( void *args )
     return STATUS_SUCCESS;
 }
 
+extern NTSTATUS replay_batch( void *args );
+
 const unixlib_entry_t __wine_unix_call_funcs[] =
 {
     process_attach,
@@ -31021,6 +31023,7 @@ const unixlib_entry_t __wine_unix_call_funcs[] =
     ext_wglSetPbufferAttribARB,
     ext_wglSetPixelFormatWINE,
     ext_wglSwapIntervalEXT,
+    replay_batch,
 };
 
 C_ASSERT(ARRAYSIZE(__wine_unix_call_funcs) == funcs_count);
@@ -31028,6 +31031,7 @@ C_ASSERT(ARRAYSIZE(__wine_unix_call_funcs) == funcs_count);
 #ifdef _WIN64
 
 extern NTSTATUS wow64_thread_attach( void *args );
+extern NTSTATUS wow64_replay_batch( void *args );
 extern NTSTATUS wow64_process_detach( void *args );
 extern NTSTATUS wow64_get_pixel_formats( void *args );
 
@@ -84668,6 +84672,7 @@ const unixlib_entry_t __wine_unix_call_wow64_funcs[] =
     wow64_ext_wglSetPbufferAttribARB,
     wow64_ext_wglSetPixelFormatWINE,
     wow64_ext_wglSwapIntervalEXT,
+    wow64_replay_batch,
 };
 
 C_ASSERT(ARRAYSIZE(__wine_unix_call_wow64_funcs) == funcs_count);
diff --git a/dlls/opengl32/unix_wgl.c b/dlls/opengl32/unix_wgl.c
index e135d9fe35..1937f5c056 100644
--- a/dlls/opengl32/unix_wgl.c
+++ b/dlls/opengl32/unix_wgl.c
@@ -1235,6 +1235,34 @@ NTSTATUS get_pixel_formats( void *args )
     return STATUS_SUCCESS;
 }
 
+/* Runs a client thread's recorded calls (see batch_unix_call in wgl.c) in
+ * order through the given call table. Each record holds the params of one
+ * call that returns nothing the client reads. */
+static NTSTATUS replay_records( const unixlib_entry_t *table, const BYTE *data, UINT size )
+{
+    const BYTE *end = data + size;
+
+    while (data + sizeof(struct batch_record) <= end)
+    {
+        const struct batch_record *record = (const struct batch_record *)data;
+        void *params = (void *)(record + 1);
+
+        if (record->code >= unix_replay_batch || (const BYTE *)params + record->size > end)
+            return STATUS_INVALID_PARAMETER;
+        table[record->code]( params );
+        data = (const BYTE *)params + ((record->size + 7) & ~7);
+    }
+    return STATUS_SUCCESS;
+}
+
+extern const unixlib_entry_t __wine_unix_call_funcs[];
+
+NTSTATUS replay_batch( void *args )
+{
+    struct replay_batch_params *params = args;
+    return replay_records( __wine_unix_call_funcs, params->data, params->size );
+}
+
 #ifdef _WIN64
 
 static pthread_mutex_t wgl_lock = PTHREAD_MUTEX_INITIALIZER;
@@ -1857,6 +1885,19 @@ NTSTATUS wow64_thread_attach( void *args )
     return thread_attach( get_teb64( (ULONG_PTR)args ));
 }
 
+extern const unixlib_entry_t __wine_unix_call_wow64_funcs[];
+
+NTSTATUS wow64_replay_batch( void *args )
+{
+    struct
+    {
+        PTR32 teb;
+        PTR32 data;
+        UINT size;
+    } *params = args;
+    return replay_records( __wine_unix_call_wow64_funcs, ULongToPtr( params->data ), params->size );
+}
+
 NTSTATUS wow64_process_detach( void *args )
 {
     NTSTATUS status;
diff --git a/dlls/opengl32/unixlib.h b/dlls/opengl32/unixlib.h
index beb63842f6..1664d4c320 100644
--- a/dlls/opengl32/unixlib.h
+++ b/dlls/opengl32/unixlib.h
@@ -28872,6 +28872,7 @@ enum unix_funcs
     unix_wglSetPbufferAttribARB,
     unix_wglSetPixelFormatWINE,
     unix_wglSwapIntervalEXT,
+    unix_replay_batch,
     funcs_count
 };
 
@@ -28888,6 +28889,28 @@ struct gl_debug_message_callback_params
     char message[1];
 };
 
+/* A client thread's batch of recorded calls (wgl.c): records of a
+ * batch_record header followed by the call's params, each 8-byte aligned,
+ * replayed in order by unix_replay_batch. */
+struct batch_record
+{
+    UINT16 code;
+    UINT16 size;
+    UINT32 padding;
+};
+
+struct replay_batch_params
+{
+    TEB *teb;
+    const void *data;
+    UINT size;
+};
+
+#ifdef WINE_UNIX_LIB
 #define UNIX_CALL( func, params ) WINE_UNIX_CALL( unix_ ## func, params )
+#else
+extern NTSTATUS batch_unix_call( enum unix_funcs code, void *params );
+#define UNIX_CALL( func, params ) batch_unix_call( unix_ ## func, (void *)(params) )
+#endif
 
 #endif /* __WINE_OPENGL32_UNIXLIB_H */
diff --git a/dlls/opengl32/wgl.c b/dlls/opengl32/wgl.c
index 2016d0a238..92978b3e8e 100644
--- a/dlls/opengl32/wgl.c
+++ b/dlls/opengl32/wgl.c
@@ -3208,6 +3208,245 @@ static NTSTATUS WINAPI call_gl_debug_message_callback( void *args, ULONG size )
     return STATUS_SUCCESS;
 }
 
+/* Immediate mode crosses to the Unix side once per call: a game drawing with
+ * glBegin/glVertex/glEnd makes tens of thousands of such calls a frame, and
+ * under WoW64 each crossing costs far more than the call itself. Calls that
+ * only feed vertices and current attributes, and return nothing, are
+ * recorded in a per-thread batch instead (array forms by value), and the
+ * batch is replayed in order on the Unix side before any other call, so
+ * the GL sees the same sequence. */
+#define BATCH_BYTES 16384
+
+struct call_batch
+{
+    UINT used;
+    BYTE data[BATCH_BYTES] DECLSPEC_ALIGN(8);
+};
+
+static void flush_batch( TEB *teb, struct call_batch *batch )
+{
+    struct replay_batch_params args = { .teb = teb, .data = batch->data, .size = batch->used };
+    NTSTATUS status;
+
+    batch->used = 0;
+    if ((status = WINE_UNIX_CALL( unix_replay_batch, &args ))) WARN( "replay_batch returned %#lx\n", status );
+}
+
+static void record_call( TEB *teb, struct call_batch *batch, enum unix_funcs code, const void *params, UINT size )
+{
+    struct batch_record *record;
+    UINT bytes = sizeof(*record) + ((size + 7) & ~7);
+
+    if (batch->used + bytes > sizeof(batch->data)) flush_batch( teb, batch );
+    record = (struct batch_record *)(batch->data + batch->used);
+    record->code = code;
+    record->size = size;
+    record->padding = 0;
+    memcpy( record + 1, params, size );
+    batch->used += bytes;
+}
+
+NTSTATUS batch_unix_call( enum unix_funcs code, void *params )
+{
+    TEB *teb = NtCurrentTeb();
+    struct call_batch *batch = teb->glReserved2;
+    union
+    {
+        struct glVertex2f_params vertex2;
+        struct glVertex3f_params vertex3;
+        struct glTexCoord2f_params texcoord2;
+        struct glColor3f_params color3;
+        struct glColor4f_params color4;
+        struct glColor3ub_params color3ub;
+        struct glColor4ub_params color4ub;
+        struct glNormal3f_params normal3;
+        struct glMultiTexCoord2f_params multitexcoord2;
+        struct glMultiTexCoord2fARB_params multitexcoord2_arb;
+    } value;
+    UINT size;
+
+    switch (code)
+    {
+#define RECORD( name ) case unix_ ## name: size = sizeof(struct name ## _params); break
+    RECORD( glBegin );
+    RECORD( glEnd );
+    RECORD( glVertex2f );
+    RECORD( glVertex3f );
+    RECORD( glVertex4f );
+    RECORD( glTexCoord2f );
+    RECORD( glColor3f );
+    RECORD( glColor4f );
+    RECORD( glColor3ub );
+    RECORD( glColor4ub );
+    RECORD( glNormal3f );
+    RECORD( glMultiTexCoord2f );
+    RECORD( glMultiTexCoord2fARB );
+    /* State calls that return nothing and take only values. */
+    RECORD( glBindTexture );
+    RECORD( glEnable );
+    RECORD( glDisable );
+    RECORD( glTexEnvf );
+    RECORD( glTexEnvi );
+    RECORD( glBlendFunc );
+    RECORD( glDepthMask );
+    RECORD( glDepthFunc );
+    RECORD( glDepthRange );
+    RECORD( glAlphaFunc );
+    RECORD( glShadeModel );
+    RECORD( glCullFace );
+    RECORD( glFrontFace );
+    RECORD( glPolygonMode );
+    RECORD( glPolygonOffset );
+    RECORD( glColorMask );
+    RECORD( glMatrixMode );
+    RECORD( glLoadIdentity );
+    RECORD( glPushMatrix );
+    RECORD( glPopMatrix );
+    RECORD( glTranslatef );
+    RECORD( glRotatef );
+    RECORD( glScalef );
+    RECORD( glOrtho );
+    RECORD( glFrustum );
+    RECORD( glViewport );
+    RECORD( glScissor );
+    RECORD( glTexParameteri );
+    RECORD( glTexParameterf );
+    RECORD( glActiveTexture );
+    RECORD( glActiveTextureARB );
+    RECORD( glClientActiveTexture );
+    RECORD( glClientActiveTextureARB );
+    RECORD( glHint );
+    RECORD( glStencilFunc );
+    RECORD( glStencilOp );
+    RECORD( glStencilMask );
+    RECORD( glClearColor );
+    RECORD( glClearDepth );
+    RECORD( glFogf );
+    RECORD( glFogi );
+    RECORD( glPointSize );
+    RECORD( glLineWidth );
+    RECORD( glTexCoord2i );
+    RECORD( glVertex2i );
+    RECORD( glVertex3i );
+    RECORD( glEnableClientState );
+    RECORD( glDisableClientState );
+    RECORD( glSelectTextureSGIS );
+    RECORD( glMTexCoord2fSGIS );
+#undef RECORD
+    case unix_glVertex2fv:
+    case unix_glVertex3fv:
+    case unix_glTexCoord2fv:
+    case unix_glColor3fv:
+    case unix_glColor4fv:
+    case unix_glColor3ubv:
+    case unix_glColor4ubv:
+    case unix_glNormal3fv:
+    case unix_glMultiTexCoord2fv:
+    case unix_glMultiTexCoord2fvARB:
+        size = 0;
+        break;
+    default:
+        if (batch && batch->used) flush_batch( teb, batch );
+        return WINE_UNIX_CALL( code, params );
+    }
+
+    if (!batch)
+    {
+        if (!(batch = malloc( sizeof(*batch) ))) return WINE_UNIX_CALL( code, params );
+        batch->used = 0;
+        teb->glReserved2 = batch;
+    }
+
+    if (!size)
+    {
+        /* The array forms point into the application's memory, which may
+         * change before the batch runs: record the value form. */
+        switch (code)
+        {
+        case unix_glVertex2fv:
+        {
+            const struct glVertex2fv_params *p = params;
+            value.vertex2 = (struct glVertex2f_params){ .teb = teb, .x = p->v[0], .y = p->v[1] };
+            record_call( teb, batch, unix_glVertex2f, &value, sizeof(value.vertex2) );
+            break;
+        }
+        case unix_glVertex3fv:
+        {
+            const struct glVertex3fv_params *p = params;
+            value.vertex3 = (struct glVertex3f_params){ .teb = teb, .x = p->v[0], .y = p->v[1], .z = p->v[2] };
+            record_call( teb, batch, unix_glVertex3f, &value, sizeof(value.vertex3) );
+            break;
+        }
+        case unix_glTexCoord2fv:
+        {
+            const struct glTexCoord2fv_params *p = params;
+            value.texcoord2 = (struct glTexCoord2f_params){ .teb = teb, .s = p->v[0], .t = p->v[1] };
+            record_call( teb, batch, unix_glTexCoord2f, &value, sizeof(value.texcoord2) );
+            break;
+        }
+        case unix_glColor3fv:
+        {
+            const struct glColor3fv_params *p = params;
+            value.color3 = (struct glColor3f_params){ .teb = teb, .red = p->v[0], .green = p->v[1], .blue = p->v[2] };
+            record_call( teb, batch, unix_glColor3f, &value, sizeof(value.color3) );
+            break;
+        }
+        case unix_glColor4fv:
+        {
+            const struct glColor4fv_params *p = params;
+            value.color4 = (struct glColor4f_params){ .teb = teb, .red = p->v[0], .green = p->v[1],
+                                                      .blue = p->v[2], .alpha = p->v[3] };
+            record_call( teb, batch, unix_glColor4f, &value, sizeof(value.color4) );
+            break;
+        }
+        case unix_glColor3ubv:
+        {
+            const struct glColor3ubv_params *p = params;
+            value.color3ub = (struct glColor3ub_params){ .teb = teb, .red = p->v[0], .green = p->v[1], .blue = p->v[2] };
+            record_call( teb, batch, unix_glColor3ub, &value, sizeof(value.color3ub) );
+            break;
+        }
+        case unix_glColor4ubv:
+        {
+            const struct glColor4ubv_params *p = params;
+            value.color4ub = (struct glColor4ub_params){ .teb = teb, .red = p->v[0], .green = p->v[1],
+                                                         .blue = p->v[2], .alpha = p->v[3] };
+            record_call( teb, batch, unix_glColor4ub, &value, sizeof(value.color4ub) );
+            break;
+        }
+        case unix_glNormal3fv:
+        {
+            const struct glNormal3fv_params *p = params;
+            value.normal3 = (struct glNormal3f_params){ .teb = teb, .nx = p->v[0], .ny = p->v[1], .nz = p->v[2] };
+            record_call( teb, batch, unix_glNormal3f, &value, sizeof(value.normal3) );
+            break;
+        }
+        case unix_glMultiTexCoord2fv:
+        {
+            const struct glMultiTexCoord2fv_params *p = params;
+            value.multitexcoord2 = (struct glMultiTexCoord2f_params){ .teb = teb, .target = p->target,
+                                                                      .s = p->v[0], .t = p->v[1] };
+            record_call( teb, batch, unix_glMultiTexCoord2f, &value, sizeof(value.multitexcoord2) );
+            break;
+        }
+        case unix_glMultiTexCoord2fvARB:
+        {
+            const struct glMultiTexCoord2fvARB_params *p = params;
+            value.multitexcoord2_arb = (struct glMultiTexCoord2fARB_params){ .teb = teb, .target = p->target,
+                                                                             .s = p->v[0], .t = p->v[1] };
+            record_call( teb, batch, unix_glMultiTexCoord2fARB, &value, sizeof(value.multitexcoord2_arb) );
+            break;
+        }
+        default:
+            break;
+        }
+        return STATUS_SUCCESS;
+    }
+
+    record_call( teb, batch, code, params, size );
+    return STATUS_SUCCESS;
+}
+
 /***********************************************************************
  *           OpenGL initialisation routine
  */
@@ -3247,6 +3486,8 @@ BOOL WINAPI DllMain( HINSTANCE hinst, DWORD reason, LPVOID reserved )
     case DLL_THREAD_DETACH:
         if ((context = get_current_context())) context->base.current_tid = 0;
         free( NtCurrentTeb()->glReserved1[WINE_GL_RESERVED_FORMATS_PTR] );
+        free( NtCurrentTeb()->glReserved2 );
+        NtCurrentTeb()->glReserved2 = NULL;
         return TRUE;
     }
     return TRUE;
