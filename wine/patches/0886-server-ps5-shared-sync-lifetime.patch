+#ifdef WINE_INPROCESS_SERVER
+static unsigned int ps5_event_read_value(struct object *obj)
+{
+    return ((struct event_sync *)obj)->signaled;
+}
+static void ps5_event_adopt_value(struct object *obj, unsigned int value)
+{
+    assert(value <= 1);
+    ((struct event_sync *)obj)->signaled = value;
+}
+void ps5_sync_retire_object(struct object *obj)
+{
+    struct event *event;
+    struct event_sync *sync;
+    if (obj->ops != &event_ops)
+    {
+        ps5_semaphore_retire_object(obj);
+        return;
+    }
+    event = (struct event *)obj;
+    event->fast_eligible = 0;
+    if (!event->sync || event->sync->ops != &event_sync_ops) return;
+    sync = (struct event_sync *)event->sync;
+    sync->fast_disabled = 1;
+    ps5_sync_retire(&sync->fast);
+}
+static int ps5_event_close_handle(struct object *obj, struct process *process, obj_handle_t handle)
+{
+    (void)process;
+    (void)handle;
+    ps5_sync_retire_object(obj);
+    return 1;
+}
+/* Native cold preparation only. A later ABI wrapper must validate the
+ * thread/TEB, module readiness and the process handle before calling. */
+int ps5_get_event_word(struct thread *thread, struct object *obj, struct pw_sync_word **word)
+{
+    struct event *event;
+    struct event_sync *sync;
+    struct ps5_sync_cell *cell;
+    if (!__atomic_load_n(&inprocess_direct_ok, __ATOMIC_ACQUIRE) || debug_level) return 0;
+    if (obj->ops != &event_ops) return 0;
+    event = (struct event *)obj;
+    if (!event->fast_eligible || obj->name || obj->handle_count != 1 ||
+        !list_empty(&event->kernel_object) ||
+        event->sync->ops != &event_sync_ops || thread->state == TERMINATED) return 0;
+    sync = (struct event_sync *)event->sync;
+    if (sync->fast_disabled) return 0;
+    cell = ps5_sync_prepare(&sync->obj, &sync->fast, &sync->fast_disabled,
+        sync->manual ? PW_SYNC_MANUAL_EVENT : PW_SYNC_AUTO_EVENT, 1,
+        ps5_event_read_value, ps5_event_adopt_value);
+    if (!cell) return sync->fast_disabled ? 0 : -1;
+    *word = &cell->word;
+    return 1;
+}
+#endif

