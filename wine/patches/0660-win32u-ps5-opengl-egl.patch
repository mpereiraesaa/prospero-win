+#endif
 
 #define CHECK_EXTENSION( ext )                                  \
     if (!has_extension( extensions, #ext ))                     \
@@ -1520,25 +1717,53 @@ static BOOL egl_init( const struct opengl_driver_funcs **driver_funcs )
         ERR( "Failed to find required extension %s\n", #ext );  \
