+     * presents its framebuffer through the PS5 driver's existing path. */
+    if (!egl->type) surface_type |= EGL_WINDOW_BIT | EGL_PBUFFER_BIT;
+#endif
 
     memset( fmt, 0, sizeof(*fmt) );
     pfd->nSize = sizeof(*pfd);
@@ -1275,7 +1396,18 @@ static void egldrv_init_extensions( struct opengl_funcs *funcs, BOOLEAN extensio
 
 static BOOL egldrv_surface_create( struct client_surface *client, int format, struct opengl_drawable **drawable )
 {
+#ifdef WINE_PS5_OPENGL
+    struct opengl_drawable *target;
+    EGLSurface surface;
+
+    if (!(surface = ps5_get_screen_surface( format ))) return FALSE;
+    if (!(target = opengl_drawable_create( sizeof(*target), &ps5_screen_funcs, format, client ))) return FALSE;
+    target->surface = surface;
+    *drawable = framebuffer_surface_create( format, client, target );
+    opengl_drawable_release( target );
+#else
     *drawable = framebuffer_surface_create( format, client, NULL );
+#endif
     return !!*drawable;
 }
 
@@ -1419,6 +1551,32 @@ static BOOL egldrv_context_create( int format, void *share, const int *attribs,
     }
     *attribs_end = EGL_NONE;
 
+#ifdef WINE_PS5_OPENGL
+    {
+        /* EGL_KHR_create_context ignores the profile mask below version 3.2,
+         * as desktop Mesa does, but the PS5 driver fails such a request with
+         * EGL_BAD_MATCH. Drop the mask so that the internal context, which
+         * asks for a core profile without a version, gets the default one. */
+        EGLint major = 1, minor = 0, *attr;
+
+        for (attr = egl_attribs; attr != attribs_end; attr += 2)
+        {
+            if (attr[0] == EGL_CONTEXT_MAJOR_VERSION_KHR) major = attr[1];
+            if (attr[0] == EGL_CONTEXT_MINOR_VERSION_KHR) minor = attr[1];
+        }
+        if (major < 3 || (major == 3 && minor < 2))
+        {
+            for (attr = egl_attribs; attr != attribs_end; attr += 2)
+                if (attr[0] == EGL_CONTEXT_OPENGL_PROFILE_MASK_KHR) break;
+            if (attr != attribs_end)
+            {
+                memmove( attr, attr + 2, (char *)(attribs_end + 1) - (char *)(attr + 2) );
+                attribs_end -= 2;
+            }
+        }
+    }
+#endif
+
     /* For now only OpenGL is supported. It's enough to set the API only for
      * context creation, since:
      * 1. the default API is EGL_OPENGL_ES_API
@@ -1490,6 +1648,40 @@ static BOOL egl_init( const struct opengl_driver_funcs **driver_funcs )
     struct opengl_funcs *funcs = &display_funcs;
     const char *extensions;
 
