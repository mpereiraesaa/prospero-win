+/* Independent strict default-off switch for event/semaphore activation. */
+static int server_shared_sync_enabled(void)
+{
+    const char *env = getenv( "WINE_PS5_SYNC_SHARED" );
+    char *path;
+    FILE *file;
+    int enabled = 0, value, end;
+
+    if (env) return !strcmp( env, "1" );
+    if (asprintf( &path, "%s/pw_sync_shared", config_dir ) == -1) return 0;
+    if ((file = fopen( path, "r" )))
+    {
+        value = fgetc( file );
+        end = fgetc( file );
+        enabled = value == '1' && (end == EOF || (end == '\n' && fgetc( file ) == EOF)) && !ferror( file );
+        fclose( file );
+    }
+    free( path );
+    return enabled;
+}
