+/* Exact canonical handles, serialized fills/clears and retained page storage.
+ * Cell kind/maximum and cached access are immutable. Retired cells remain SLOW.
+ * Warm operations only load ready/page/slot then attempt one strong word CAS. */
+#define PW_SYNC_CACHE_PAGES 128u
+#define PW_SYNC_CACHE_SLOTS (65536u / sizeof(uintptr_t))
+static uintptr_t *shared_sync_pages[PW_SYNC_CACHE_PAGES];
+static uintptr_t shared_sync_initial[PW_SYNC_CACHE_SLOTS];
+
+static uintptr_t *shared_sync_slot(obj_handle_t handle, int allocate)
+{
+    unsigned int index, page;
+    uintptr_t *slots;
+    if (!handle || (handle & 3)) return NULL;
+    index = (handle >> 2) - 1;
+    page = index / PW_SYNC_CACHE_SLOTS;
+    if (page >= PW_SYNC_CACHE_PAGES) return NULL;
+    slots = __atomic_load_n(&shared_sync_pages[page], __ATOMIC_ACQUIRE);
+    if (!slots && allocate)
+    {
+        slots = page ? anon_mmap_alloc(65536, PROT_READ | PROT_WRITE) : shared_sync_initial;
+        if (slots == MAP_FAILED) return NULL;
+        __atomic_store_n(&shared_sync_pages[page], slots, __ATOMIC_RELEASE);
+    }
+    return slots ? &slots[index % PW_SYNC_CACHE_SLOTS] : NULL;
+}
+
+/* Caller holds fd_cache_mutex with server signals blocked. Allocation, invalid
+ * handles and server-context failures retry; only valid ineligible handles
+ * produce exact negative entries. No guest pointer is passed to the backend. */
+static uintptr_t shared_sync_fill(struct thread_data *data, obj_handle_t handle)
+{
+    struct pw_sync_word *word = NULL;
+    uint32_t access = 0;
+    uintptr_t *slot, value;
+    int ret;
+    if (!pw_sync_backend_ready(shared_sync_backend) ||
+        !(slot = shared_sync_slot(handle, 1))) return 0;
+    value = __atomic_load_n(slot, __ATOMIC_ACQUIRE);
+    if (value) return value;
+    ret = shared_sync_backend->get_word(PW_SYNC_BACKEND_VERSION, data->tid, inprocess_teb(),
+                                        handle, &word, &access);
+    if (ret == PW_SYNC_LOOKUP_NEGATIVE) value = PW_SYNC_SLOT_NEGATIVE;
+    else if (ret == PW_SYNC_LOOKUP_READY && word && !((uintptr_t)word & 63) &&
+             pw_sync_word_value_valid(word, 0))
+        value = (uintptr_t)word | ((access & SYNCHRONIZE) ? PW_SYNC_SLOT_SYNCHRONIZE : 0) |
+                ((access & (word->kind == PW_SYNC_SEMAPHORE ? SEMAPHORE_MODIFY_STATE :
+                                                               EVENT_MODIFY_STATE)) ? PW_SYNC_SLOT_MODIFY : 0);
+    else return 0;
+    __atomic_store_n(slot, value, __ATOMIC_RELEASE);
+    return value;
+}
+
+static unsigned int server_try_shared_sync_inprocess(HANDLE handle, unsigned int operation, unsigned int count,
+                                    const LARGE_INTEGER *timeout, unsigned int *previous)
+{
+    struct thread_data *data = get_thread_data();
+    obj_handle_t h = wine_server_obj_handle(handle);
+    uintptr_t *slot, value;
+    struct pw_sync_word *word;
+    uint32_t old;
+    sigset_t sigset;
+    if (!data->tid || operation > PW_SYNC_RELEASE ||
+        !pw_sync_backend_ready(shared_sync_backend)) return STATUS_NOT_IMPLEMENTED;
+    slot = shared_sync_slot(h, 0);
+    value = slot ? __atomic_load_n(slot, __ATOMIC_ACQUIRE) : 0;
+    if (value == PW_SYNC_SLOT_NEGATIVE) return STATUS_NOT_IMPLEMENTED;
+    if (!value)
+    {
+        server_enter_uninterrupted_section(&fd_cache_mutex, &sigset);
+        value = shared_sync_fill(data, h);
+        server_leave_uninterrupted_section(&fd_cache_mutex, &sigset);
+    }
+    if (!value || value == PW_SYNC_SLOT_NEGATIVE ||
+        !pw_sync_backend_ready(shared_sync_backend)) return STATUS_NOT_IMPLEMENTED;
+    word = pw_sync_slot_word(value);
+    if (operation == PW_SYNC_WAIT)
+    {
+        if (!(value & PW_SYNC_SLOT_SYNCHRONIZE)) return STATUS_NOT_IMPLEMENTED;
+        if (timeout) { volatile timeout_t when = timeout->QuadPart; (void)when; }
+        if (!pw_sync_word_try_wait(word)) return STATUS_NOT_IMPLEMENTED;
+    }
+    else
+    {
+        if (!(value & PW_SYNC_SLOT_MODIFY)) return STATUS_NOT_IMPLEMENTED;
+        if (operation == PW_SYNC_RELEASE)
+        {
+            if (!pw_sync_word_try_release(word, count, &old)) return STATUS_NOT_IMPLEMENTED;
+        }
+        else if (!pw_sync_word_try_event(word, operation == PW_SYNC_SET, &old))
+            return STATUS_NOT_IMPLEMENTED;
+        if (previous) *previous = old;
+    }
+    return STATUS_SUCCESS;
+}
+
+/* Called under fd_cache_mutex through all existing mutex cache invalidations. */
+static void server_clear_shared_sync_slot(HANDLE handle)
+{
+    uintptr_t *slot = shared_sync_slot(wine_server_obj_handle(handle), 0);
+    if (slot) __atomic_store_n(slot, 0, __ATOMIC_RELEASE);
+}
+#endif
+
+unsigned int server_try_shared_sync(HANDLE handle, unsigned int operation, unsigned int count,
+                                    const LARGE_INTEGER *timeout, unsigned int *previous)
+{
+#ifdef WINE_INPROCESS_SERVER
+    return server_try_shared_sync_inprocess(handle, operation, count, timeout, previous);
+#else
+    return STATUS_NOT_IMPLEMENTED;
+#endif
+}
+
 /* Caller already holds fd_cache_mutex, beside close_inproc_sync. */
 void server_clear_shared_mutex_slot( HANDLE handle )
 {
 #ifdef WINE_INPROCESS_SERVER
     uintptr_t *slot = shared_mutex_slot( wine_server_obj_handle( handle ), 0 );
+    server_clear_shared_sync_slot(handle);
     if (slot) __atomic_store_n( slot, 0, __ATOMIC_RELEASE );
 #endif
 }
@@ -1735,6 +1874,15 @@
         if (query && pw_mutex_backend_valid( api = query( PW_MUTEX_BACKEND_VERSION )))
             shared_mutex_backend = api;
