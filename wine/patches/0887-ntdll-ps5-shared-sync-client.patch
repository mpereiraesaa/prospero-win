 #endif

 /* Some versions of glibc don't define this */
@@ -417,6 +418,66 @@
         &inprocess_direct_ok, get_shared_mutex_word
     };
     return version == PW_MUTEX_BACKEND_VERSION ? &api : NULL;
+}
+
+/* Passive discovery; only a cold lookup under the existing server lock may
+ * activate a cell. Outputs remain local and unchanged unless lookup is ready. */
+static int get_shared_sync_word(uint32_t version, uint32_t tid, uint64_t teb, uint32_t handle,
+                                struct pw_sync_word **word, uint32_t *access)
+{
+    struct thread *thread;
+    struct object *obj;
+    struct pw_sync_word *cell = NULL;
+    unsigned int saved_error, saved_global_error;
+    int found, ret = PW_SYNC_LOOKUP_RETRY;
+    if (version != PW_SYNC_BACKEND_VERSION ||
+        !__atomic_load_n(&inprocess_direct_ok, __ATOMIC_ACQUIRE)) return ret;
+    if (pthread_mutex_trylock(&inprocess_server_mutex)) return ret;
+    saved_global_error = global_error;
+    if (!__atomic_load_n(&inprocess_direct_ok, __ATOMIC_ACQUIRE) || current || debug_level) goto unlock;
+    if (!(thread = get_thread_from_id(tid))) goto unlock;
+    if (thread->teb == teb && teb && thread->state != TERMINATED && thread->reply_fd &&
+        !thread->req_toread && !thread->reply_towrite && !thread->req_data && !thread->reply_data &&
+        thread_can_fast_mutex(thread))
+    {
+        saved_error = thread->error;
+        current = thread;
+        clear_error();
+        ps5_mutex_server_begin();
+        if ((obj = get_handle_obj(thread->process, handle, 0, NULL)))
+        {
+            found = ps5_get_event_word(thread, obj, &cell);
+            if (!found) found = ps5_get_semaphore_word(thread, obj, &cell);
+            if (found > 0)
+            {
+                *word = cell;
+                *access = get_handle_access(thread->process, handle);
+                ret = PW_SYNC_LOOKUP_READY;
+            }
+            else if (!found && __atomic_load_n(&inprocess_direct_ok, __ATOMIC_ACQUIRE))
+                ret = PW_SYNC_LOOKUP_NEGATIVE;
+            release_object(obj);
+        }
+        current = NULL;
+        ps5_mutex_server_end();
+        thread->error = saved_error;
+    }
+    release_object(thread);
+unlock:
+    global_error = saved_global_error;
+    ps5_mutex_server_reconcile();
+    pthread_mutex_unlock(&inprocess_server_mutex);
+    return ret;
+}
+
+DECLSPEC_EXPORT const struct pw_sync_backend *pw_wineserver_sync_backend(uint32_t version)
+{
+    static const struct pw_sync_backend api =
+    {
+        PW_SYNC_BACKEND_VERSION, sizeof(api), sizeof(struct pw_sync_word), sizeof(void *),
+        &inprocess_direct_ok, get_shared_sync_word
+    };
+    return version == PW_SYNC_BACKEND_VERSION ? &api : NULL;
 }

 /* Requests a client thread may run itself: they act on sync objects,
