@@ -170,6 +358,9 @@ static bool mutex_init( struct object *obj, const void *init_data );
 static struct object *mutex_get_sync( struct object *obj );
 static int mutex_signal( struct object *obj, unsigned int access, int signal );
 static void mutex_destroy( struct object *obj );
+#ifdef WINE_INPROCESS_SERVER
+static int ps5_mutex_close_handle( struct object *obj, struct process *process, obj_handle_t handle );
+#endif

 static const struct object_ops mutex_ops =
 {
@@ -180,6 +371,9 @@ static const struct object_ops mutex_ops =
     .signal   = mutex_signal,
     .get_sync = mutex_get_sync,
     .destroy  = mutex_destroy,
+#ifdef WINE_INPROCESS_SERVER
+    .close_handle = ps5_mutex_close_handle,
+#endif
 };

 #ifdef WINE_INPROCESS_SERVER
@@ -196,6 +390,7 @@ int try_fast_mutex( struct thread *thread, obj_handle_t handle, int release, uns
                                                 release ? 0 : SYNCHRONIZE, &mutex_ops ))) return 0;
     if (mutex->sync->ops != &mutex_sync_ops) goto done;
     sync = (struct mutex_sync *)mutex->sync;
+    ps5_mutex_enter_slow( sync );

     /* Let select handle abandonment and every existing waiter, including
      * wait-all and other processes. A final release may then wake them. */
@@ -218,9 +413,77 @@ done:
 }
 #endif

+#ifdef WINE_INPROCESS_SERVER
+void ps5_mutex_retire_object( struct object *obj )
+{
+    struct mutex *mutex;
+    if (obj->ops != &mutex_ops) return;
+    mutex = (struct mutex *)obj;
+    mutex->fast_eligible = 0;
+    if (mutex->sync && mutex->sync->ops == &mutex_sync_ops)
+        ps5_mutex_retire( (struct mutex_sync *)mutex->sync );
+}
+
+static int ps5_mutex_close_handle( struct object *obj, struct process *process, obj_handle_t handle )
+{
+    (void)process;
+    (void)handle;
+    ps5_mutex_retire_object( obj );
+    return 1;
+}
+
+/* Server-lock-held cold preparation, native local outputs only. The caller
+ * must validate the thread/TEB, ABI, module readiness and opt-in policy.
+ * No current runtime caller exists, so no cell is activated by this patch.
+ * Narrow policy is experimental until the owner's census proves coverage. */
+int ps5_get_mutex_word( struct thread *thread, obj_handle_t handle, struct pw_mutex_word **word,
+                        unsigned int *token, unsigned int *access )
+{
+    struct mutex *mutex;
+    struct mutex_sync *sync;
+    struct ps5_mutex_cell *cell;
+    void *storage;
+    int ret = 0;
+    if (!__atomic_load_n( &inprocess_direct_ok, __ATOMIC_ACQUIRE ) || thread->state == TERMINATED) return 0;
+    if (!(mutex = (struct mutex *)get_handle_obj( thread->process, handle, 0, &mutex_ops ))) return 0;
+    if (!mutex->fast_eligible || mutex->obj.name || mutex->obj.handle_count != 1 ||
+        mutex->sync->ops != &mutex_sync_ops || !ps5_mutex_thread_token( thread )) goto done;
+    sync = (struct mutex_sync *)mutex->sync;
+    if (sync->fast_disabled || (sync->owner && sync->owner->process != thread->process)) goto done;
+    if (!(cell = sync->fast))
+    {
+        if (posix_memalign( &storage, 64, sizeof(*cell) )) goto done;
+        cell = storage;
+        memset( cell, 0, sizeof(*cell) );
+        cell->word.word = PW_MUTEX_WORD_SLOW;
+        cell->sync = (struct mutex_sync *)grab_object( sync );
+        cell->process = (struct process *)grab_object( thread->process );
+        sync->fast = cell;
+        list_add_tail( &ps5_mutex_active, &cell->active_entry );
+        ps5_mutex_queue_publish( cell );
+    }
+    *word = &cell->word;
+    *token = thread->ps5_mutex_token;
+    *access = get_handle_access( thread->process, handle );
+    ret = 1;
+done:
+    release_object( mutex );
+    return ret;
+}
+#endif
+
 void abandon_mutexes( struct thread *thread )
 {
     struct list *ptr;
+#ifdef WINE_INPROCESS_SERVER
+    struct ps5_mutex_cell *cell;
+    /* Promptly fold a currently published owner before legacy abandonment.
+     * A later observer also recognizes vanished/TERMINATED tokens lazily. */
+    LIST_FOR_EACH_ENTRY( cell, &ps5_mutex_active, struct ps5_mutex_cell, active_entry )
+        if (cell->process == thread->process && thread->ps5_mutex_token &&
+            pw_mutex_word_owner( pw_mutex_word_load( &cell->word ) ) == thread->ps5_mutex_token)
+            ps5_mutex_enter_slow( cell->sync );
+#endif

     while ((ptr = list_head( &thread->mutex_list )) != NULL)
     {
@@ -245,6 +508,9 @@ static bool mutex_init( struct object *obj, const void *init_data )
     struct mutex *mutex = (struct mutex *)obj;
     const struct mutex_init_data *data = init_data;

+#ifdef WINE_INPROCESS_SERVER
+    mutex->fast_eligible = data->fast_eligible;
+#endif
     return !!(mutex->sync = create_mutex_sync( data->owned ));
 }

@@ -275,6 +541,9 @@ static void mutex_destroy( struct object *obj )
 {
     struct mutex *mutex = (struct mutex *)obj;
     assert( obj->ops == &mutex_ops );
+#ifdef WINE_INPROCESS_SERVER
+    ps5_mutex_retire_object( obj );
+#endif
