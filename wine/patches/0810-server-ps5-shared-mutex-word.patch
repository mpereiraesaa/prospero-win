 /* grab a mutex for a given thread */
 static void do_grab( struct mutex_sync *mutex, struct thread *thread )
 {
+    ps5_mutex_enter_slow( mutex );
     assert( !mutex->count || (mutex->owner == thread) );

     if (!mutex->count++)  /* FIXME: avoid wrap-around */
@@ -92,6 +117,7 @@ static void do_grab( struct mutex_sync *mutex, struct thread *thread )
 /* release a mutex once the recursion count is 0 */
 static int do_release( struct mutex_sync *mutex, struct thread *thread, int count )
 {
+    ps5_mutex_enter_slow( mutex );
     if (!mutex->count || (mutex->owner != thread))
     {
         set_error( STATUS_MUTANT_NOT_OWNED );
@@ -108,10 +134,158 @@ static int do_release( struct mutex_sync *mutex, struct thread *thread, int coun
     return 1;
 }

+#ifdef WINE_INPROCESS_SERVER
+/* Native-only cold backend. No exported function or client activates it yet.
+ * Cells are individually aligned and never freed/reused, including retirement.
+ * All metadata and both lists are accessed only under the server lock. */
+struct ps5_mutex_cell
+{
+    struct pw_mutex_word word;
+    struct mutex_sync *sync;
+    struct process *process;
+    struct list active_entry;
+    struct list pending_entry;
+    int pending;
+};
+static struct list ps5_mutex_active = LIST_INIT(ps5_mutex_active);
+static struct list ps5_mutex_pending = LIST_INIT(ps5_mutex_pending);
+static unsigned int ps5_mutex_operation_depth;
+static unsigned int ps5_mutex_last_token;
+
+static unsigned int ps5_mutex_thread_token( struct thread *thread )
+{
+    if (!thread->ps5_mutex_token && ps5_mutex_last_token != ~0u)
+        thread->ps5_mutex_token = ++ps5_mutex_last_token;
+    return thread->ps5_mutex_token;
+}
+
+static struct thread *ps5_mutex_find_owner( struct ps5_mutex_cell *cell, unsigned int token )
+{
+    struct thread *thread;
+    LIST_FOR_EACH_ENTRY( thread, &cell->process->thread_list, struct thread, proc_entry )
+        if (thread->ps5_mutex_token == token && thread->state != TERMINATED) return thread;
+    return NULL;
+}
+
+static void ps5_mutex_queue_publish( struct ps5_mutex_cell *cell )
+{
+    if (cell->pending) return;
+    list_add_tail( &ps5_mutex_pending, &cell->pending_entry );
+    cell->pending = 1;
+}
+
+static void ps5_mutex_enter_slow( struct mutex_sync *mutex )
+{
+    struct ps5_mutex_cell *cell = mutex->fast;
+    struct thread *owner;
+    uint64_t old;
+    unsigned int count;
+    if (!cell) return;
+    ps5_mutex_queue_publish( cell );
+    if (!pw_mutex_word_freeze( &cell->word, &old )) return;
+    assert( !mutex->owner && !mutex->count );
+    if (!(count = pw_mutex_word_count( old ))) return;
+    if (!(owner = ps5_mutex_find_owner( cell, pw_mutex_word_owner( old ) )))
+    {
+        mutex->abandoned = 1;
+        return;
+    }
+    /* do_grab recursively enters SLOW, which cannot adopt a second time. */
+    do_grab( mutex, owner );
+    mutex->count = count;
+}
+
+static int ps5_mutex_add_queue( struct object *obj, struct wait_queue_entry *entry )
+{
+    ps5_mutex_enter_slow( (struct mutex_sync *)obj );
+    return add_queue( obj, entry );
+}
+
+static void ps5_mutex_remove_queue( struct object *obj, struct wait_queue_entry *entry )
+{
+    struct mutex_sync *mutex = (struct mutex_sync *)obj;
+    ps5_mutex_enter_slow( mutex );
+    remove_queue( obj, entry );
+    /* Never publish here: wake_up/end_wait can still be changing other
+     * objects, references and queues in a nested multiwait completion. */
+}
+
+void ps5_mutex_server_begin(void)
+{
+    ++ps5_mutex_operation_depth;
+}
+
+void ps5_mutex_server_reconcile(void)
+{
+    struct ps5_mutex_cell *cell;
+    struct mutex_sync *mutex;
+    struct list *entry;
+    uint64_t word;
+    unsigned int token;
+    if (ps5_mutex_operation_depth) return;
+    while ((entry = list_head( &ps5_mutex_pending )))
+    {
+        cell = LIST_ENTRY( entry, struct ps5_mutex_cell, pending_entry );
+        list_remove( entry );
+        cell->pending = 0;
+        mutex = cell->sync;
+        assert( mutex && mutex->fast == cell );
+        if (!__atomic_load_n( &inprocess_direct_ok, __ATOMIC_ACQUIRE ) ||
+            mutex->abandoned || !list_empty( &mutex->obj.wait_queue )) continue;
+        if (mutex->owner && mutex->owner->state == TERMINATED) continue;
+        token = mutex->owner ? ps5_mutex_thread_token( mutex->owner ) : 0;
+        if (!pw_mutex_word_compose( token, mutex->count, &word )) continue;
+        if (mutex->owner)
+        {
+            list_remove( &mutex->entry );
+            mutex->owner = NULL;
+            mutex->count = 0;
+            /* The activation pin survives dropping the ownership pin. */
+            release_object( mutex );
+        }
+        pw_mutex_word_publish( &cell->word, word );
+    }
+}
+
+void ps5_mutex_server_end(void)
+{
+    assert( ps5_mutex_operation_depth );
+    if (!--ps5_mutex_operation_depth) ps5_mutex_server_reconcile();
+}
+
+static void ps5_mutex_retire( struct mutex_sync *mutex )
+{
+    struct ps5_mutex_cell *cell = mutex->fast;
+    struct process *process;
+    mutex->fast_disabled = 1;
+    if (!cell) return;
+    ps5_mutex_enter_slow( mutex );
+    if (cell->pending) list_remove( &cell->pending_entry );
+    cell->pending = 0;
+    list_remove( &cell->active_entry );
+    process = cell->process;
+    cell->sync = NULL;
+    cell->process = NULL;
+    mutex->fast = NULL;
+    /* SLOW stays set forever. The retained word is still safe for a stale
+     * native client to read, and can never bind to a different sync. */
+    release_object( process );
+    release_object( mutex );
+}
+
+void ps5_mutex_server_disable(void)
+{
+    struct list *entry;
+    while ((entry = list_head( &ps5_mutex_active )))
+        ps5_mutex_retire( LIST_ENTRY( entry, struct ps5_mutex_cell, active_entry )->sync );
+}
+#endif
+
 static void mutex_sync_dump( struct object *obj, int verbose )
 {
     struct mutex_sync *mutex = (struct mutex_sync *)obj;
     assert( obj->ops == &mutex_sync_ops );
+    ps5_mutex_enter_slow( mutex );
     fprintf( stderr, "Mutex count=%u owner=%p\n", mutex->count, mutex->owner );
 }

@@ -120,12 +294,16 @@ static void mutex_sync_destroy( struct object *obj )
     struct mutex_sync *mutex = (struct mutex_sync *)obj;
     assert( obj->ops == &mutex_sync_ops );
     assert( !mutex->count );
+#ifdef WINE_INPROCESS_SERVER
+    assert( !mutex->fast );
+#endif
 }

 static int mutex_sync_signaled( struct object *obj, struct wait_queue_entry *entry )
 {
     struct mutex_sync *mutex = (struct mutex_sync *)obj;
     assert( obj->ops == &mutex_sync_ops );
+    ps5_mutex_enter_slow( mutex );
     return (!mutex->count || (mutex->owner == get_wait_queue_thread( entry )));
 }

@@ -149,6 +327,10 @@ static struct object *create_mutex_sync( int owned )
     mutex->count = 0;
     mutex->owner = NULL;
     mutex->abandoned = 0;
