 /**********************************************************************
  *           wow64_NtQueryInformationProcess
  */
+
+/* Private bootstrap v1: fixed-width, synchronous, no guest pointer is passed
+ * to the PE64 module. The module must join children before returning. */
+struct pw_native_bootstrap
+{
+    ULONG version, size;
+    WCHAR path[260];
+    ULONGLONG result[8];
+};
+C_ASSERT( sizeof(struct pw_native_bootstrap) == 592 );
+
+static DWORD WINAPI pw_native_service( void *arg )
+{
+    struct pw_native_bootstrap *request = arg;
+    UNICODE_STRING path;
+    ANSI_STRING symbol = RTL_CONSTANT_STRING( "PwD3D9ServiceMain" );
+    DWORD (WINAPI *entry)( ULONGLONG *result );
+    HMODULE module;
+    NTSTATUS status;
+
+    RtlInitUnicodeString( &path, request->path );
+    if ((status = LdrLoadDll( NULL, 0, &path, &module ))) return status;
+    if (!(status = LdrGetProcedureAddress( module, &symbol, 0, (void **)&entry )))
+        status = entry( request->result );
+    LdrUnloadDll( module );
+    return status;
+}
+
+static NTSTATUS pw_native_bootstrap( HANDLE process, void *ptr, ULONG len, ULONG *retlen )
+{
+    struct pw_native_bootstrap *request;
+    THREAD_BASIC_INFORMATION info;
+    HANDLE thread;
+    NTSTATUS status;
+
+    if (retlen) *retlen = sizeof(*request);
+    if (process != GetCurrentProcess()) return STATUS_NOT_SUPPORTED;
+    if (len != sizeof(*request)) return STATUS_INFO_LENGTH_MISMATCH;
+    if (!ptr) return STATUS_INVALID_PARAMETER;
+    if (!(request = RtlAllocateHeap( GetProcessHeap(), 0, sizeof(*request) ))) return STATUS_NO_MEMORY;
+    memcpy( request, ptr, sizeof(*request) );
+    if (request->version != 1 || request->size != sizeof(*request) ||
+        request->path[1] != 0x3a || request->path[2] != 0x5c || request->path[259])
+    {
+        RtlFreeHeap( GetProcessHeap(), 0, request );
+        return STATUS_INVALID_PARAMETER;
+    }
+    memset( request->result, 0, sizeof(request->result) );
+    status = NtCreateThreadEx( &thread, THREAD_ALL_ACCESS, NULL, GetCurrentProcess(),
+                               (PRTL_THREAD_START_ROUTINE)pw_native_service, request,
+                               0x80000000, 0, 0, 0, NULL );
+    if (!status)
+    {
+        status = NtWaitForSingleObject( thread, FALSE, NULL );
+        if (!status) status = NtQueryInformationThread( thread, ThreadBasicInformation, &info, sizeof(info), NULL );
+        if (!status) status = info.ExitStatus;
+        if (!status) memcpy( ptr, request, sizeof(*request) );
+        NtClose( thread );
+    }
+    RtlFreeHeap( GetProcessHeap(), 0, request );
+    return status;
+}
+
 NTSTATUS WINAPI wow64_NtQueryInformationProcess( UINT *args )
 {
     HANDLE handle = get_handle( &args );
@@ -580,6 +644,8 @@
     ULONG *retlen = get_ptr( &args );
 
