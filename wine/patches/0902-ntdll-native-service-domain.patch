Subject: ntdll: add an explicit native PE64 bootstrap domain in WoW64

diff --git a/dlls/ntdll/loader.c b/dlls/ntdll/loader.c
--- a/dlls/ntdll/loader.c
+++ b/dlls/ntdll/loader.c
@@ -3990,7 +3990,11 @@
                             DLL_THREAD_DETACH, NULL );
         }
 
-        if (wm->ldr.TlsIndex == -1) call_tls_callbacks( wm->ldr.DllBase, DLL_THREAD_DETACH );
+        if (wm->ldr.TlsIndex == -1
+#ifdef _WIN64
+            && !(pWow64PrepareForException && !NtCurrentTeb()->WowTebOffset)
+#endif
+           ) call_tls_callbacks( wm->ldr.DllBase, DLL_THREAD_DETACH );
     }
 
     RtlAcquirePebLock();
@@ -4535,6 +4539,34 @@
     {
 #ifdef _WIN64
         if (NtCurrentTeb()->WowTebOffset) init_wow64( context );
+        if (pWow64LdrpInitialize)
+        {
+            /* WoW64 process initialization did not load native kernel32 or
+             * attach the PE64 loader graph. Do this once under the loader lock. */
+            if (!node_kernel32)
+            {
+                WINE_MODREF *kernel32;
+                if ((status = load_dll( NULL, L"kernel32.dll", 0, &kernel32, FALSE )))
+                    goto native_domain_failed;
+                node_kernel32 = kernel32->ldr.DdagNode;
+                pBaseThreadInitThunk = RtlFindExportedRoutineByName( kernel32->ldr.DllBase,
+                                                                    "BaseThreadInitThunk" );
+                actctx_init();
+                locale_init();
+            }
+            NtCurrentTeb()->FlsSlots = fls_alloc_data();
+            if ((status = alloc_thread_tls())) goto native_domain_failed;
+            if ((status = process_attach( node_ntdll, NULL )) ||
+                (status = process_attach( node_kernel32, NULL )))
+                goto native_domain_failed;
+            if (!NtCurrentTeb()->SkipThreadAttach) thread_attach();
+            RtlLeaveCriticalSection( &loader_section );
+            return;
+        native_domain_failed:
+            RtlLeaveCriticalSection( &loader_section );
+            NtTerminateThread( GetCurrentThread(), status );
+            return;
+        }
 #endif
 #ifdef __arm64ec__
         arm64ec_thread_init();
