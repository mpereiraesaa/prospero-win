From c8a62bf0b92ebe864348ddb04186f3539bbdd8d4 Mon Sep 17 00:00:00 2001
From: Manuel Pereira <manuelpereiralds@gmail.com>
Date: Tue, 29 Sep 2026 16:49:41 +0200
Subject: [PATCH] ntdll: Keep the pages that fault most often for the title's
 log.

A game can spin on one fault at tens of thousands a second (Warcraft III
on the PS5 showed about 33,000 a second and a black screen) where logging
each fault would flood the log. virtual_handle_fault now counts faults per
4 KiB page and kind in a fixed 16-entry table (space-saving), with the
page's protection, its host page's combined protection, how the fault was
resolved and the last faulting PC, and __wine_virtual_fault_top copies the
most counted entries.
---
 dlls/ntdll/unix/virtual.c | 72 +++++++++++++++++++++++++++++++++++++++
 1 file changed, 72 insertions(+)

diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
index 0a83dfd251..68184341cc 100644
--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -214,6 +214,77 @@ static inline int counted_mprotect( void *addr, size_t len, int prot )
     return ret;
 }
 
+/* The pages that fault most often, for the title's log: a fixed table kept
+ * by the space-saving rule (a new page takes the least counted entry and
+ * adds one to its count), so a storm of faults on one page stands out
+ * without logging each fault. Entries are keyed by the 4 KiB page and what
+ * the fault was: its kind, the page's protection, its host page's combined
+ * protection and how the fault was resolved. */
+struct fault_top_entry
+{
+    ULONG64 count;
+    ULONG_PTR page;
+    ULONG_PTR pc;
+    UINT info;
+};
+static struct fault_top_entry fault_top[16];
+
+static void fault_top_note( const void *addr, ULONG_PTR err, BYTE page_vprot, BYTE host_vprot,
+                            NTSTATUS ret, const void *pc )
+{
+    ULONG_PTR page = (ULONG_PTR)addr & ~(ULONG_PTR)0xfff;
+    UINT info = (UINT)(err & 0xff) << 24 | (UINT)page_vprot << 16 | (UINT)host_vprot << 8 |
+                (ret == STATUS_SUCCESS ? 1 : ret == STATUS_ACCESS_VIOLATION ? 2 : 3);
+    unsigned int i, low = 0;
+
+    for (i = 0; i < ARRAY_SIZE(fault_top); i++)
+    {
+        if (fault_top[i].count && fault_top[i].page == page && fault_top[i].info == info)
+        {
+            fault_top[i].count++;
+            fault_top[i].pc = (ULONG_PTR)pc;
+            return;
+        }
+        if (fault_top[i].count < fault_top[low].count) low = i;
+    }
+    fault_top[low].count++;
+    fault_top[low].page = page;
+    fault_top[low].pc = (ULONG_PTR)pc;
+    fault_top[low].info = info;
+}
+
+/***********************************************************************
+ *           __wine_virtual_fault_top
+ *
+ * Copy the most counted fault pages, most first, four values each: count,
+ * 4 KiB page, the last faulting PC, and info (kind << 24 | page vprot << 16
+ * | host page vprot << 8 | 1 resolved, 2 access violation, 3 other). Returns
+ * the entries copied. Read without the lock: a diagnostic may see an entry
+ * mid-update.
+ */
+DECLSPEC_EXPORT unsigned int __wine_virtual_fault_top( ULONG64 *out, unsigned int count )
+{
+    struct fault_top_entry sorted[ARRAY_SIZE(fault_top)];
+    unsigned int i, j, n = 0;
+
+    memcpy( sorted, fault_top, sizeof(sorted) );
+    for (i = 1; i < ARRAY_SIZE(sorted); i++)
+        for (j = i; j > 0 && sorted[j - 1].count < sorted[j].count; j--)
+        {
+            struct fault_top_entry swap = sorted[j];
+            sorted[j] = sorted[j - 1];
+            sorted[j - 1] = swap;
+        }
+    for (i = 0; out && i < ARRAY_SIZE(sorted) && sorted[i].count && (n + 1) * 4 <= count; i++, n++)
+    {
+        out[n * 4] = sorted[i].count;
+        out[n * 4 + 1] = sorted[i].page;
+        out[n * 4 + 2] = sorted[i].pc;
+        out[n * 4 + 3] = sorted[i].info;
+    }
+    return n;
+}
+
 #define mmap counted_mmap
 #define munmap counted_munmap
 #define mprotect counted_mprotect
@@ -4834,6 +4905,7 @@ NTSTATUS virtual_handle_fault( struct thread_data *data, EXCEPTION_RECORD *rec,
                 ret = STATUS_SUCCESS;
         }
     }
+    fault_top_note( addr, err, get_page_vprot( addr ), vprot, ret, rec->ExceptionAddress );
     mutex_unlock( &virtual_mutex );
     rec->ExceptionCode = ret;
     return ret;
-- 
2.43.0

