+#ifdef WINE_INPROCESS_SERVER
+/* Exact canonical handle table, like Wine's fd table, never a modulo hint.
+ * Page pointers and slots are acquire/release atomic. Pages are never freed.
+ * fd_cache_mutex serializes every fill and all four close invalidations. */
+#define PW_MUTEX_CACHE_PAGES 128u
+#define PW_MUTEX_CACHE_SLOTS (65536u / sizeof(uintptr_t))
+static uintptr_t *shared_mutex_pages[PW_MUTEX_CACHE_PAGES];
+static uintptr_t shared_mutex_initial[PW_MUTEX_CACHE_SLOTS];
+
+static uintptr_t *shared_mutex_slot( obj_handle_t handle, int allocate )
+{
+    unsigned int index = (handle >> 2) - 1;
+    unsigned int page = index / PW_MUTEX_CACHE_SLOTS;
+    uintptr_t *slots;
+    if (page >= PW_MUTEX_CACHE_PAGES) return NULL;
+    slots = __atomic_load_n( &shared_mutex_pages[page], __ATOMIC_ACQUIRE );
+    if (!slots && allocate)
+    {
+        slots = page ? anon_mmap_alloc( 65536, PROT_READ | PROT_WRITE ) : shared_mutex_initial;
+        if (slots == MAP_FAILED) return NULL;
+        __atomic_store_n( &shared_mutex_pages[page], slots, __ATOMIC_RELEASE );
+    }
+    return slots ? &slots[index % PW_MUTEX_CACHE_SLOTS] : NULL;
+}
+
+/* Caller holds fd_cache_mutex with server signals blocked. Do not cache
+ * transient lookup failures. A negative slot never needs a thread token. */
+static uintptr_t shared_mutex_fill( struct thread_data *data, obj_handle_t handle )
+{
+    struct pw_mutex_word *word = NULL;
+    uint32_t token = 0, access = 0;
+    uintptr_t *slot, value;
+    int ret;
+    if (!pw_mutex_backend_ready( shared_mutex_backend ) ||
+        !(slot = shared_mutex_slot( handle, 1 ))) return 0;
+    value = __atomic_load_n( slot, __ATOMIC_ACQUIRE );
+    if (value == PW_MUTEX_SLOT_NEGATIVE || (value && data->ps5_mutex_token)) return value;
+    ret = shared_mutex_backend->get_word( PW_MUTEX_BACKEND_VERSION, data->tid, inprocess_teb(),
+                                          handle, &word, &token, &access );
+    if (ret == PW_MUTEX_LOOKUP_NEGATIVE)
+        value = PW_MUTEX_SLOT_NEGATIVE;
+    else if (ret == PW_MUTEX_LOOKUP_READY && word && !((uintptr_t)word & 63) && token)
+    {
+        data->ps5_mutex_token = token;
+        value = (uintptr_t)word | ((access & SYNCHRONIZE) ? PW_MUTEX_SLOT_SYNCHRONIZE : 0);
+    }
+    else return 0;
+    __atomic_store_n( slot, value, __ATOMIC_RELEASE );
+    return value;
+}
+
+/* Only the cold miss section changes signals/takes a lock. The ordinary
+ * path preserves guest waits/errors; all outputs to it happen after CAS. */
+static unsigned int server_try_shared_mutex( HANDLE handle, int release,
+                                             const LARGE_INTEGER *timeout, LONG *prev_count )
+{
+    struct thread_data *data = get_thread_data();
+    obj_handle_t h = wine_server_obj_handle( handle );
+    uintptr_t *slot, value;
+    struct pw_mutex_word *word;
+    uint32_t previous;
+    sigset_t sigset;
+    if (!data->tid || !pw_mutex_backend_ready( shared_mutex_backend )) return STATUS_NOT_IMPLEMENTED;
+    slot = shared_mutex_slot( h, 0 );
+    value = slot ? __atomic_load_n( slot, __ATOMIC_ACQUIRE ) : 0;
+    if (value == PW_MUTEX_SLOT_NEGATIVE) return STATUS_NOT_IMPLEMENTED;
+    if (!value || !data->ps5_mutex_token)
+    {
+        server_enter_uninterrupted_section( &fd_cache_mutex, &sigset );
+        value = shared_mutex_fill( data, h );
+        server_leave_uninterrupted_section( &fd_cache_mutex, &sigset );
+    }
+    if (!value || value == PW_MUTEX_SLOT_NEGATIVE ||
+        !pw_mutex_backend_ready( shared_mutex_backend )) return STATUS_NOT_IMPLEMENTED;
+    word = pw_mutex_slot_word( value );
+    if (release)
+    {
+        if (!pw_mutex_word_try_release( word, data->ps5_mutex_token, &previous )) return STATUS_NOT_IMPLEMENTED;
+        if (prev_count) *prev_count = 1 - previous;
+    }
+    else
+    {
+        if (!(value & PW_MUTEX_SLOT_SYNCHRONIZE)) return STATUS_NOT_IMPLEMENTED;
+        if (timeout) { volatile timeout_t when = timeout->QuadPart; (void)when; }
+        if (!pw_mutex_word_try_acquire( word, data->ps5_mutex_token )) return STATUS_NOT_IMPLEMENTED;
+    }
+    return STATUS_SUCCESS;
+}
+#endif
+
+/* Caller already holds fd_cache_mutex, beside close_inproc_sync. */
+void server_clear_shared_mutex_slot( HANDLE handle )
+{
+#ifdef WINE_INPROCESS_SERVER
+    uintptr_t *slot = shared_mutex_slot( wine_server_obj_handle( handle ), 0 );
+    if (slot) __atomic_store_n( slot, 0, __ATOMIC_RELEASE );
+#endif
+}
