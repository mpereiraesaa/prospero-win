             server_start_time = reply->server_start;
@@ -2159,6 +2275,7 @@ NTSTATUS WINAPI NtDuplicateObject( HANDLE source_process, HANDLE source, HANDLE
     if (options & DUPLICATE_CLOSE_SOURCE)
     {
         fd = remove_fd_from_cache( source );
+        server_clear_shared_mutex_slot( source );
         close_inproc_sync( source );
