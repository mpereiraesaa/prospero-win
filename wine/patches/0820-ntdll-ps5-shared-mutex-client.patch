     if (!try_server_mutex || !data->tid) return STATUS_NOT_IMPLEMENTED;
     if (!release && server_skip_fast_mutex( h )) return STATUS_NOT_IMPLEMENTED;
     if (!release && timeout)
@@ -1090,6 +1193,7 @@ unsigned int server_queue_process_apc( HANDLE process, const union apc_call *cal
             server_enter_uninterrupted_section( &fd_cache_mutex, &sigset );

             /* remove the handle from the cache, get_apc_result will close it for us */
