+/* Negative entries describe a valid, permanently ineligible handle only.
+ * Invalid handles and allocation/readiness/token failures must be retried;
+ * they cannot poison a handle value created later without a preceding close. */
+int ps5_describe_mutex_word( struct thread *thread, obj_handle_t handle, struct pw_mutex_word **word,
+                            unsigned int *token, unsigned int *access )
+{
+    struct object *obj;
+    struct mutex *mutex;
+    int ret = PW_MUTEX_LOOKUP_RETRY;
+    if (!(obj = get_handle_obj( thread->process, handle, 0, NULL ))) return ret;
+    if (obj->ops != &mutex_ops) ret = PW_MUTEX_LOOKUP_NEGATIVE;
+    else
+    {
+        mutex = (struct mutex *)obj;
+        if (!mutex->fast_eligible || obj->name || obj->handle_count != 1 ||
+            mutex->sync->ops != &mutex_sync_ops || ((struct mutex_sync *)mutex->sync)->fast_disabled)
+            ret = PW_MUTEX_LOOKUP_NEGATIVE;
+        else if (ps5_get_mutex_word( thread, handle, word, token, access ))
+            ret = PW_MUTEX_LOOKUP_READY;
+    }
+    release_object( obj );
+    return ret;
+}
 #endif

 void abandon_mutexes( struct thread *thread )
