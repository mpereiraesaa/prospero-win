+/* Native caller-local outputs, with server signals blocked by the client's
+ * fd_cache_mutex section. ABI discovery is passive; this lookup may activate. */
+static int get_shared_mutex_word( uint32_t version, uint32_t tid, uint64_t teb, uint32_t handle,
+                                  struct pw_mutex_word **word, uint32_t *token, uint32_t *access )
+{
+    struct thread *thread;
+    unsigned int saved_error, saved_global_error;
+    int ret = PW_MUTEX_LOOKUP_RETRY;
+    if (version != PW_MUTEX_BACKEND_VERSION ||
+        !__atomic_load_n( &inprocess_direct_ok, __ATOMIC_ACQUIRE )) return ret;
+    if (pthread_mutex_trylock( &inprocess_server_mutex )) return ret;
+    saved_global_error = global_error;
+    if (!__atomic_load_n( &inprocess_direct_ok, __ATOMIC_ACQUIRE ) || current || debug_level) goto unlock;
+    if (!(thread = get_thread_from_id( tid ))) goto unlock;
+    if (thread->teb == teb && teb && thread->state != TERMINATED && thread->reply_fd &&
+        !thread->req_toread && !thread->reply_towrite && !thread->req_data && !thread->reply_data &&
+        thread_can_fast_mutex( thread ))
+    {
+        saved_error = thread->error;
+        current = thread;
+        clear_error();
+        ps5_mutex_server_begin();
+        ret = ps5_describe_mutex_word( thread, handle, word, token, access );
+        current = NULL;
+        ps5_mutex_server_end();
+        thread->error = saved_error;
+    }
+    release_object( thread );
+unlock:
+    global_error = saved_global_error;
+    ps5_mutex_server_reconcile();
+    pthread_mutex_unlock( &inprocess_server_mutex );
+    return ret;
+}
+
+/* The connection retains the wineserver module until process teardown, as
+ * with its existing direct-call pointers. Ready can be revoked atomically;
+ * retired cells stay readable and SLOW until that same module teardown. */
+DECLSPEC_EXPORT const struct pw_mutex_backend *pw_wineserver_mutex_backend( uint32_t version )
+{
+    static const struct pw_mutex_backend api =
+    {
+        PW_MUTEX_BACKEND_VERSION, sizeof(api), sizeof(struct pw_mutex_word), sizeof(void *),
+        &inprocess_direct_ok, get_shared_mutex_word
+    };
+    return version == PW_MUTEX_BACKEND_VERSION ? &api : NULL;
+}
+
